+class TestClose(unittest.TestCase):
+    """Property 9: Close. 
+    close(account) raises KeyError for unknown, ValueError for already closed or non-zero.
+    Closed account keeps history: balance and statement still answer.
+    Mutant: let post reach closed account.
+    """
+    
+    def setUp(self):
+        self.ledger = Ledger({"USD": 2})
+        self.ledger.open("cash", "USD")
+        self.ledger.open("checking", "USD")
+    
+    def test_close_unknown_account_raises_keyerror(self):
+        """Closing unknown account raises KeyError."""
+        with self.assertRaises(KeyError):
+            self.ledger.close("unknown")
+    
+    def test_close_nonzero_account_raises(self):
+        """Closing account with non-zero balance raises ValueError."""
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=1)
+        
+        with self.assertRaises(ValueError):
+            self.ledger.close("cash")
+    
+    def test_close_already_closed_raises(self):
+        """Closing already-closed account raises ValueError."""
+        # First close
+        self.ledger.close("cash")
+        
+        # Try to close again
+        with self.assertRaises(ValueError):
+            self.ledger.close("cash")
+    
+    def test_close_zero_balance_succeeds(self):
+        """Closing account with zero balance succeeds."""
+        self.ledger.close("cash")
+        # Should not raise
+    
+    def test_closed_account_post_raises(self):
+        """Posting to closed account raises ValueError."""
+        self.ledger.close("cash")
+        
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "5"), ("checking", "-5")], when=1)
+    
+    def test_closed_account_history_accessible(self):
+        """Closed account still has accessible history."""
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=10)
+        self.ledger.post([("cash", "-5"), ("checking", "5")], when=20)
+        
+        # Now balance is zero
+        self.ledger.close("cash")
+        
+        # Should still be able to query
+        balance = self.ledger.balance("cash")
+        self.assertEqual(balance, Decimal("0.00"))
+        
+        statement = self.ledger.statement("cash", 0, 100)
+        self.assertEqual(len(statement), 2)
+
