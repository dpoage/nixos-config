+class TestKeys(unittest.TestCase):
+    """Property 7: idempotency keys compare whole requests as multisets."""
+
+    def test_same_key_same_request_reordered_returns_id(self):
+        ledger = usd_ledger()
+        first = ledger.post([("cash", "5"), ("bank", "-5")], when=1, key="k")
+        second = ledger.post([("bank", "-5.0"), ("cash", "5")], when=1, key="k")
+        self.assertEqual(first, 1)
+        self.assertEqual(second, 1)
+        self.assertEqual(
+            ledger.balances(),
+            {"bank": Decimal("-5.00"), "cash": Decimal("5.00")},
+        )
+        self.assertEqual(len(ledger.statement("cash", 0, 10)), 1)
+
+    def test_same_key_different_when_raises(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1, key="k")
+        with self.assertRaises(ValueError):
+            ledger.post([("cash", "5"), ("bank", "-5")], when=2, key="k")
+        self.assertEqual(len(ledger.statement("cash", 0, 10)), 1)
+
+    def test_same_key_different_splitting_raises(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1, key="k")
+        with self.assertRaises(ValueError):
+            ledger.post(
+                [("cash", "2"), ("cash", "3"), ("bank", "-5")], when=1, key="k"
+            )
+        self.assertEqual(ledger.balance("cash"), Decimal("5.00"))
+
+    def test_same_key_different_amount_raises(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1, key="k")
+        with self.assertRaises(ValueError):
+            ledger.post([("cash", "6"), ("bank", "-6")], when=1, key="k")
+        self.assertEqual(ledger.balance("cash"), Decimal("5.00"))
+
+    def test_replay_returns_id_after_accounts_close(self):
+        ledger = usd_ledger()
+        self.assertEqual(
+            ledger.post([("cash", "5"), ("bank", "-5")], when=1, key="a"), 1
+        )
+        self.assertEqual(
+            ledger.post([("cash", "-5"), ("bank", "5")], when=2, key="b"), 2
+        )
+        ledger.close("bank")
+        ledger.close("cash")
+        self.assertEqual(
+            ledger.post([("cash", "-5"), ("bank", "5")], when=2, key="b"), 2
+        )
+        self.assertEqual(
+            ledger.post([("cash", "5"), ("bank", "-5")], when=1, key="a"), 1
+        )
+        with self.assertRaises(ValueError):
+            ledger.post([("cash", "5"), ("bank", "-5")], when=1, key="b")
+
+    def test_post_and_reverse_share_keys(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1, key="k")
+        with self.assertRaises(ValueError):
+            ledger.reverse(1, when=1, key="k")
+        self.assertEqual(ledger.balance("cash"), Decimal("5.00"))
+        self.assertEqual(ledger.reverse(1, when=1, key="r"), 2)
+        # Replaying the reversal returns its id even though it is a reversal.
+        self.assertEqual(ledger.reverse(1, when=1, key="r"), 2)
+        with self.assertRaises(ValueError):
+            ledger.post([("cash", "5"), ("bank", "-5")], when=1, key="r")
+        self.assertEqual(ledger.balance("cash"), Decimal("0.00"))
+
+    def test_failed_call_does_not_claim_key(self):
+        ledger = usd_ledger()
+        with self.assertRaises(ValueError):
+            ledger.post([("cash", "5"), ("bank", "-4")], when=1, key="k")
+        self.assertEqual(
+            ledger.post([("cash", "5"), ("bank", "-5")], when=1, key="k"), 1
+        )
+        with self.assertRaises(KeyError):
+            ledger.post([("nope", "5"), ("bank", "-5")], when=2, key="n")
+        self.assertEqual(
+            ledger.post([("equity", "1"), ("bank", "-1")], when=2, key="n"), 2
+        )
+
+    def test_failed_reversal_does_not_claim_key(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=5)
+        with self.assertRaises(ValueError):
+            ledger.reverse(1, when=4, key="r")
+        with self.assertRaises(KeyError):
+            ledger.reverse(99, when=5, key="s")
+        self.assertEqual(ledger.reverse(1, when=5, key="r"), 2)
+        self.assertEqual(ledger.reverse(1, when=5, key="r"), 2)
+
+    def test_replay_uses_no_new_id(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1, key="k")
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1, key="k")
+        self.assertEqual(
+            ledger.post([("cash", "1"), ("bank", "-1")], when=2), 2
+        )
