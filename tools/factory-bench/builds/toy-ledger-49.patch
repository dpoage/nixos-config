+"""Double-entry ledger. Maintains accounts in multiple currencies."""
+
+from decimal import Decimal
+import re
+from typing import Optional, Iterable
 
 
 class Ledger:
-    def __init__(self, currencies):
-        raise NotImplementedError
+    """A double-entry ledger supporting multiple currencies.
+    
+    Each account is opened for a single currency. All transactions
+    must balance per currency (debits equal credits within each).
+    """
+
+    def __init__(self, currencies: dict[str, int]) -> None:
+        """Initialize with currency exponents.
+        
+        Args:
+            currencies: Mapping of currency code to decimal exponent.
+                       Negative exponents raise ValueError.
+        """
+        for code, exp in currencies.items():
+            if exp < 0:
+                raise ValueError(f"Exponent for {code} is negative")
+        
+        self._currencies = currencies
+        self._accounts = {}  # account name -> currency
+        self._closed = set()  # closed account names
+        self._transactions = []  # list of (entries, when, is_reversal, reversed_by_id)
+        self._reversals = {}  # original_txn_id -> reversing_txn_id
+        self._reversed_by = {}  # reversing_txn_id -> original_txn_id
+        self._keys = {}  # key -> (txn_id, request_tuple)
+        self._lines = {}  # (account, txn_id) -> amount in account's currency
+
+    def open(self, account: str, currency: str) -> None:
+        """Open a new account for a currency.
+        
+        Raises:
+            KeyError: if currency is not in this ledger.
+            ValueError: if account already exists.
+        """
+        if currency not in self._currencies:
+            raise KeyError(f"Currency {currency} not in ledger")
+        if account in self._accounts:
+            raise ValueError(f"Account {account} already exists")
+        
+        self._accounts[account] = currency
+
+    def post(
+        self,
+        entries: Iterable[tuple[str, str]],
+        *,
+        when: int,
+        key: Optional[str] = None,
+    ) -> int:
+        """Post a transaction.
+        
+        Args:
+            entries: Iterable of (account, amount_str) pairs.
+            when: Timestamp for this transaction.
+            key: Optional idempotency key.
+        
+        Returns:
+            Transaction ID (1-indexed).
+        
+        Raises:
+            KeyError: if an account is unknown.
+            ValueError: if amount is invalid, fewer than 2 entries, 
+                       account is closed, or entries don't balance per currency.
+        """
+        entries_list = list(entries)
+        
+        # Validate: at least 2 entries
+        if len(entries_list) < 2:
+            raise ValueError("Transaction must have at least 2 entries")
+        
+        # Check for unknown accounts first (KeyError takes precedence)
+        for account, amount_str in entries_list:
+            if account not in self._accounts:
+                raise KeyError(f"Account {account} not found")
+        
+        # Validate amounts and collect by currency
+        amounts_by_currency = {}
+        for account, amount_str in entries_list:
+            currency = self._accounts[account]
+            amount = self._parse_amount(amount_str, currency)
+            if currency not in amounts_by_currency:
+                amounts_by_currency[currency] = Decimal(0)
+            amounts_by_currency[currency] += amount
+        
+        # Check that each currency balances
+        for currency, total in amounts_by_currency.items():
+            if total != 0:
+                raise ValueError(f"Currency {currency} does not balance")
+        
+        # Check for closed accounts
+        for account, _ in entries_list:
+            if account in self._closed:
+                raise ValueError(f"Account {account} is closed")
+        
+        # Build request tuple for key deduplication
+        request = self._make_request(entries_list, when)
+        
+        # Check for duplicate key with same request
+        if key is not None:
+            if key in self._keys:
+                prev_id, prev_request = self._keys[key]
+                if prev_request == request:
+                    return prev_id
+                else:
+                    raise ValueError(f"Key {key} already used for different request")
+        
+        # Accept the transaction
+        txn_id = len(self._transactions) + 1
+        self._transactions.append({
+            'entries': entries_list,
+            'when': when,
+            'is_reversal': False,
+            'reversed_by_id': None,
+        })
+        
+        # Record lines for each account
+        for account, amount_str in entries_list:
+            currency = self._accounts[account]
+            amount = self._parse_amount(amount_str, currency)
+            self._lines[(account, txn_id)] = amount
+        
+        # Record key
+        if key is not None:
+            self._keys[key] = (txn_id, request)
+        
+        return txn_id
+
+    def reverse(
+        self,
+        txn_id: int,
+        *,
+        when: int,
+        key: Optional[str] = None,
+    ) -> int:
+        """Reverse a transaction.
+        
+        Args:
+            txn_id: ID of transaction to reverse.
+            when: Timestamp for the reversal.
+            key: Optional idempotency key.
+        
+        Returns:
+            ID of the reversal transaction.
+        
+        Raises:
+            KeyError: if txn_id is unknown.
+            ValueError: if original is a reversal, already reversed, 
+                       when < original's when, or an account is closed.
+        """
+        # Check if txn_id exists
+        if txn_id < 1 or txn_id > len(self._transactions):
+            raise KeyError(f"Transaction {txn_id} not found")
+        
+        original = self._transactions[txn_id - 1]
+        
+        # Can't reverse a reversal
+        if original['is_reversal']:
+            raise ValueError(f"Cannot reverse transaction {txn_id} (is itself a reversal)")
+        
+        # Can't reverse twice
+        if txn_id in self._reversals:
+            raise ValueError(f"Transaction {txn_id} already reversed")
+        
+        # Timestamp must be >= original
+        if when < original['when']:
+            raise ValueError(f"Reversal timestamp must be >= original")
+        
+        # Check for closed accounts in the reversal
+        for account, _ in original['entries']:
+            if account in self._closed:
+                raise ValueError(f"Account {account} is closed")
+        
+        # Build the reversal entries (negate amounts)
+        reversal_entries = [
+            (account, self._negate_amount(amount_str))
+            for account, amount_str in original['entries']
+        ]
+        
+        # Build request for deduplication
+        request = ('reverse', txn_id, when)
+        
+        # Check for duplicate key
+        if key is not None:
+            if key in self._keys:
+                prev_id, prev_request = self._keys[key]
+                if prev_request == request:
+                    return prev_id
+                else:
+                    raise ValueError(f"Key {key} already used for different request")
+        
+        # Accept reversal
+        reversal_id = len(self._transactions) + 1
+        self._transactions.append({
+            'entries': reversal_entries,
+            'when': when,
+            'is_reversal': True,
+            'reversed_by_id': None,
+        })
+        
+        # Record lines for reversal
+        for account, amount_str in reversal_entries:
+            currency = self._accounts[account]
+            amount = self._parse_amount(amount_str, currency)
+            self._lines[(account, reversal_id)] = amount
+        
+        # Mark original as reversed
+        self._reversals[txn_id] = reversal_id
+        self._reversed_by[reversal_id] = txn_id
+        self._transactions[txn_id - 1]['reversed_by_id'] = reversal_id
+        
+        # Record key
+        if key is not None:
+            self._keys[key] = (reversal_id, request)
+        
+        return reversal_id
+
+    def balance(self, account: str, *, at: Optional[int] = None) -> Decimal:
+        """Get account balance at a time.
+        
+        Args:
+            account: Account name.
+            at: Timestamp (None means all transactions).
+        
+        Returns:
+            Balance as Decimal with proper exponent.
+        
+        Raises:
+            KeyError: if account is unknown.
+        """
+        if account not in self._accounts:
+            raise KeyError(f"Account {account} not found")
+        
+        currency = self._accounts[account]
+        exponent = self._currencies[currency]
+        
+        total = Decimal(0)
+        for txn_id in range(1, len(self._transactions) + 1):
+            txn = self._transactions[txn_id - 1]
+            if at is None or txn['when'] <= at:
+                key = (account, txn_id)
+                if key in self._lines:
+                    total += self._lines[key]
+        
+        # Ensure proper exponent
+        return total.quantize(Decimal(10) ** -exponent)
+
+    def balances(self, *, at: Optional[int] = None) -> dict[str, Decimal]:
+        """Get all non-zero balances at a time.
+        
+        Args:
+            at: Timestamp (None means all transactions).
+        
+        Returns:
+            Dict mapping account names (sorted) to balances.
+        """
+        result = {}
+        for account in sorted(self._accounts.keys()):
+            balance = self.balance(account, at=at)
+            if balance != 0:
+                result[account] = balance
+        return result
+
+    def statement(
+        self,
+        account: str,
+        start: int,
+        end: int,
+    ) -> list[tuple]:
+        """Get account statement in a time range.
+        
+        Args:
+            account: Account name.
+            start: Start time (inclusive).
+            end: End time (exclusive).
+        
+        Returns:
+            List of (when, txn_id, amount, running) tuples.
+        
+        Raises:
+            KeyError: if account is unknown.
+            ValueError: if start > end.
+        """
+        if account not in self._accounts:
+            raise KeyError(f"Account {account} not found")
+        
+        if start > end:
+            raise ValueError("start > end")
+        
+        currency = self._accounts[account]
+        exponent = self._currencies[currency]
+        
+        # Collect lines with running balance
+        lines = []
+        running = Decimal(0)
+        
+        for txn_id in range(1, len(self._transactions) + 1):
+            txn = self._transactions[txn_id - 1]
+            when = txn['when']
+            key = (account, txn_id)
+            
+            if key in self._lines:
+                amount = self._lines[key]
+                running += amount
+                
+                # Include lines in range
+                if start <= when < end:
+                    lines.append((when, txn_id, amount, running.quantize(Decimal(10) ** -exponent)))
+        
+        # Sort by when, then by txn_id
+        lines.sort(key=lambda x: (x[0], x[1]))
+        return lines
+
+    def close(self, account: str) -> None:
+        """Close an account.
+        
+        Args:
+            account: Account name.
+        
+        Raises:
+            KeyError: if account is unknown.
+            ValueError: if already closed or balance is not zero.
+        """
+        if account not in self._accounts:
+            raise KeyError(f"Account {account} not found")
+        
+        if account in self._closed:
+            raise ValueError(f"Account {account} already closed")
+        
+        balance = self.balance(account)
+        if balance != 0:
+            raise ValueError(f"Cannot close account with non-zero balance")
+        
+        self._closed.add(account)
+
+    def _parse_amount(self, amount_str: str, currency: str) -> Decimal:
+        """Parse and validate an amount string.
+        
+        Raises:
+            ValueError: if amount is invalid.
+        """
+        # Must match pattern
+        if not re.match(r'^-?\d+(\.\d+)?$', amount_str):
+            raise ValueError(f"Invalid amount: {amount_str}")
+        
+        # Can't be zero
+        if Decimal(amount_str) == 0:
+            raise ValueError(f"Amount cannot be zero")
+        
+        # Check exponent
+        exponent = self._currencies[currency]
+        decimal_amount = Decimal(amount_str)
+        
+        # Get the number of decimal places
+        if '.' in amount_str:
+            decimal_places = len(amount_str.split('.')[1])
+        else:
+            decimal_places = 0
+        
+        if decimal_places > exponent:
+            raise ValueError(f"Amount has too many decimal places for {currency}")
+        
+        return decimal_amount
+
+    def _negate_amount(self, amount_str: str) -> str:
+        """Negate an amount string."""
+        decimal_amount = Decimal(amount_str)
+        negated = -decimal_amount
+        # Format back to string
+        if '.' in amount_str:
+            # Keep the same format
+            decimal_places = len(amount_str.split('.')[1])
+            format_str = f'{{:.{decimal_places}f}}'
+            return format_str.format(negated).rstrip('0').rstrip('.')
+        else:
+            return str(negated)
+
+    def _make_request(self, entries_list: list, when: int) -> tuple:
+        """Create a canonical request tuple for idempotency."""
+        # Normalize entries as a sorted multiset
+        normalized = []
+        for account, amount_str in entries_list:
+            currency = self._accounts[account]
+            amount = self._parse_amount(amount_str, currency)
+            normalized.append((account, amount))
+        normalized.sort()
+        return ('post', when, tuple(normalized))
