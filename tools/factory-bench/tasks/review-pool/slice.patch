+class QuotaTest(unittest.TestCase):
+    def test_validates_arguments(self):
+        pool = make()
+        with self.assertRaises(KeyError):
+            pool.set_quota("nope", 1)
+        for quota in (True, -1, 1.5, "1"):
+            with self.subTest(quota=quota):
+                with self.assertRaises(ValueError):
+                    pool.set_quota("root", quota)
+
+    def test_equal_quota_changes_nothing(self):
+        pool = make(root=5)
+        pool.set_quota("root", 5)
+        self.assertEqual(pool.events(), [])
+
+    def test_above_new_quota_without_evict_raises(self):
+        pool = make(root=5)
+        pool.reserve("root", 5, 0, 10)
+        before = pool.events()
+        with self.assertRaises(ValueError):
+            pool.set_quota("root", 4)
+        self.assertEqual(pool.events(), before)
+        self.assertEqual(pool.usage("root", 0), 5)
+        self.assertEqual(pool.status(1), "active")
+
+    def test_usage_may_equal_the_new_quota(self):
+        pool = make(root=10)
+        pool.reserve("root", 4, 0, 5)
+        pool.set_quota("root", 4)
+        self.assertEqual(
+            pool.events(),
+            [("active", 1), ("quota", "root", 10, 4)],
+        )
+        self.assertEqual(pool.status(1), "active")
+        # The same quota again is not a change.
+        pool.set_quota("root", 4)
+        self.assertEqual(
+            pool.events(),
+            [("active", 1), ("quota", "root", 10, 4)],
+        )
+
+    def test_eviction_follows_victim_order(self):
+        pool = make(root=10)
+        pool.reserve("root", 4, 0, 10)
+        pool.reserve("root", 4, 0, 10)
+        pool.set_quota("root", 5, evict=True)
+        self.assertEqual(
+            pool.events(),
+            [
+                ("active", 1),
+                ("active", 2),
+                ("quota", "root", 10, 5),
+                ("evicted", 2),
+            ],
+        )
+        self.assertEqual(pool.status(1), "active")
+        self.assertEqual(pool.status(2), "evicted")
+        self.assertEqual(pool.usage("root", 0), 4)
+
+    def test_eviction_leaves_candidates_that_cover_no_excess(self):
+        pool = make(root=10)
+        pool.reserve("root", 4, 0, 5)
+        pool.reserve("root", 2, 10, 20)
+        pool.set_quota("root", 3, evict=True)
+        self.assertEqual(
+            pool.events(),
+            [
+                ("active", 1),
+                ("active", 2),
+                ("quota", "root", 10, 3),
+                ("evicted", 1),
+            ],
+        )
+        self.assertEqual(pool.status(2), "active")
+
+    def test_accepted_change_settles(self):
+        pool = make(root=5)
+        pool.reserve("root", 5, 0, 10)
+        pool.reserve("root", 2, 0, 10, wait=True)
+        pool.set_quota("root", 7)
+        self.assertEqual(pool.status(2), "active")
+        self.assertEqual(
+            pool.events(),
+            [
+                ("active", 1),
+                ("waiting", 2),
+                ("quota", "root", 5, 7),
+                ("promoted", 2),
+            ],
+        )
+
+    def test_eviction_then_settle(self):
+        pool = make(root=8)
+        pool.reserve("root", 4, 0, 10, priority=0)
+        pool.reserve("root", 4, 0, 10, priority=0)
+        pool.reserve("root", 1, 0, 10, priority=7, wait=True)
+        pool.set_quota("root", 5, evict=True)
+        self.assertEqual(pool.status(2), "evicted")
+        self.assertEqual(pool.status(1), "active")
+        self.assertEqual(pool.status(3), "active")
+        self.assertEqual(
+            pool.events(),
+            [
+                ("active", 1),
+                ("active", 2),
+                ("waiting", 3),
+                ("quota", "root", 8, 5),
+                ("evicted", 2),
+                ("promoted", 3),
+            ],
+        )
