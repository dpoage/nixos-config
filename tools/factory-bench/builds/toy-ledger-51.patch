+class KeysTests(unittest.TestCase):
+    """Test Property 7: Keys."""
+
+    def setUp(self):
+        self.ledger = Ledger({"USD": 2})
+        self.ledger.open("cash", "USD")
+        self.ledger.open("expense", "USD")
+
+    def test_idempotent_key_same_request(self):
+        """Same key with same request returns same txn_id."""
+        txn_id1 = self.ledger.post(
+            [("cash", "5"), ("expense", "-5")], when=10, key="key1"
+        )
+        txn_id2 = self.ledger.post(
+            [("cash", "5"), ("expense", "-5")], when=10, key="key1"
+        )
+        self.assertEqual(txn_id1, txn_id2)
+        # Verify only one transaction
+        self.assertEqual(self.ledger.balance("cash"), Decimal("5.00"))
+
+    def test_idempotent_key_different_request_raises(self):
+        """Same key with different request raises ValueError."""
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=10, key="key1")
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "10"), ("expense", "-10")], when=10, key="key1")
+
+    def test_key_ignores_entry_order(self):
+        """Key treats entries as multiset (order doesn't matter)."""
+        txn_id1 = self.ledger.post(
+            [("cash", "5"), ("expense", "-5")], when=10, key="key1"
+        )
+        txn_id2 = self.ledger.post(
+            [("expense", "-5"), ("cash", "5")], when=10, key="key1"
+        )
+        self.assertEqual(txn_id1, txn_id2)
+
+    def test_key_distinguishes_string_amounts(self):
+        """Key distinguishes string representations: '5.0' vs '5'."""
+        txn_id1 = self.ledger.post(
+            [("cash", "5"), ("expense", "-5")], when=10, key="key1"
+        )
+        # '5.0' and '5' represent the same value but different strings
+        # They should NOT be treated as the same request
+        with self.assertRaises(ValueError):
+            self.ledger.post(
+                [("cash", "5.0"), ("expense", "-5.0")], when=10, key="key1"
+            )
+
+    def test_post_and_reverse_share_key_space(self):
+        """post and reverse share the same key namespace."""
+        post_id = self.ledger.post(
+            [("cash", "5"), ("expense", "-5")], when=10, key="key1"
+        )
+        with self.assertRaises(ValueError):
+            self.ledger.reverse(post_id, when=11, key="key1")
