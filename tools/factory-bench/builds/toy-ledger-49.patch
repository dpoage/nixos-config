+class TestStatement(unittest.TestCase):
+    """Property 6: Statement. 
+    statement(account, start, end) lists nonzero lines with start <= when < end,
+    ordered by when then id, as (when, txn_id, amount, running).
+    running is balance after line, counting every earlier line in order, including before start.
+    start > end raises ValueError.
+    Mutant: start running at zero at start.
+    """
+    
+    def setUp(self):
+        self.ledger = Ledger({"USD": 2})
+        self.ledger.open("cash", "USD")
+        self.ledger.open("checking", "USD")
+    
+    def test_statement_start_gt_end_raises(self):
+        """Statement with start > end raises ValueError."""
+        with self.assertRaises(ValueError):
+            self.ledger.statement("cash", 20, 10)
+    
+    def test_statement_format(self):
+        """Statement returns tuples of (when, txn_id, amount, running)."""
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=10)
+        statement = self.ledger.statement("cash", 0, 100)
+        self.assertEqual(len(statement), 1)
+        when, txn_id, amount, running = statement[0]
+        self.assertEqual(when, 10)
+        self.assertEqual(txn_id, 1)
+        self.assertEqual(amount, Decimal("5.00"))
+        self.assertEqual(running, Decimal("5.00"))
+    
+    def test_statement_respects_range(self):
+        """Statement only includes lines with start <= when < end."""
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=10)
+        self.ledger.post([("cash", "3"), ("checking", "-3")], when=20)
+        self.ledger.post([("cash", "2"), ("checking", "-2")], when=30)
+        
+        statement = self.ledger.statement("cash", 15, 25)
+        self.assertEqual(len(statement), 1)
+        self.assertEqual(statement[0][0], 20)
+    
+    def test_statement_running_includes_before_start(self):
+        """Running balance includes lines before start."""
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=10)
+        self.ledger.post([("cash", "3"), ("checking", "-3")], when=20)
+        
+        statement = self.ledger.statement("cash", 15, 25)
+        # Only txn at 20 is in range, but running should include txn at 10
+        self.assertEqual(statement[0][3], Decimal("8.00"))  # 5 + 3
+    
+    def test_statement_sorted_by_when_then_id(self):
+        """Statement is sorted by when, then by txn_id."""
+        self.ledger.post([("cash", "2"), ("checking", "-2")], when=10)
+        self.ledger.post([("cash", "1"), ("checking", "-1")], when=10)
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=20)
+        
+        statement = self.ledger.statement("cash", 0, 100)
+        # Txn 1 and 2 both at time 10, should be ordered by id
+        self.assertEqual(statement[0][1], 1)
+        self.assertEqual(statement[1][1], 2)
+        self.assertEqual(statement[2][1], 3)
+
