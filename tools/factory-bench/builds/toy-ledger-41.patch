+    """A double-entry ledger that holds several currencies."""
+
+    def __init__(self, currencies: dict[str, int]):
+        """Initialize with currencies and their decimal exponents.
+
+        Args:
+            currencies: dict mapping currency code to decimal exponent.
+
+        Raises:
+            ValueError: if any exponent is negative.
+        """
+        for code, exponent in currencies.items():
+            if exponent < 0:
+                raise ValueError(f"Exponent for {code} cannot be negative")
+        self.currencies = currencies
+        self.accounts = {}
+        self.transactions = []
+        self.keys = {}
+
+    def open(self, account: str, currency: str) -> None:
+        """Open an account for the given currency.
+
+        Args:
+            account: account name.
+            currency: currency code.
+
+        Raises:
+            KeyError: if currency is unknown.
+            ValueError: if account already exists.
+        """
+        if currency not in self.currencies:
+            raise KeyError(f"Unknown currency: {currency}")
+        if account in self.accounts:
+            raise ValueError(f"Account already exists: {account}")
+        self.accounts[account] = {
+            "currency": currency,
+            "lines": [],
+            "closed": False,
+        }
+
+    def post(self, entries, *, when: int, key: str | None = None) -> int:
+        """Post entries to accounts.
+
+        Args:
+            entries: iterable of (account, amount_str) pairs.
+            when: transaction timestamp.
+            key: optional idempotency key.
+
+        Returns:
+            transaction id (1-indexed).
+
+        Raises:
+            KeyError: if unknown account or currency.
+            ValueError: if entries are invalid or don't balance.
+        """
+        entries_list = list(entries)
+        if len(entries_list) < 2:
+            raise ValueError("At least two entries required")
+
+        request = ("post", when, tuple(sorted(entries_list)))
+        if key and key in self.keys:
+            if self.keys[key] == request:
+                return self._get_txn_id_from_request(request)
+            raise ValueError(f"Key {key} used for different request")
+
+        amounts_by_currency = {}
+        parsed_entries = []
+        for account, amount_str in entries_list:
+            if account not in self.accounts:
+                raise KeyError(f"Unknown account: {account}")
+            if self.accounts[account]["closed"]:
+                raise ValueError(f"Account is closed: {account}")
+            currency = self.accounts[account]["currency"]
+            amount = self._parse_amount(amount_str, currency)
+            parsed_entries.append((account, amount_str, amount))
+            if currency not in amounts_by_currency:
+                amounts_by_currency[currency] = Decimal(0)
+            amounts_by_currency[currency] += amount
+
+        for currency, total in amounts_by_currency.items():
+            if total != 0:
+                raise ValueError(
+                    f"Entries for {currency} do not sum to zero"
+                )
+
+        txn_id = len(self.transactions) + 1
+        self.transactions.append({
+            "id": txn_id,
+            "type": "post",
+            "when": when,
+            "entries": parsed_entries,
+            "reversed_by": None,
+            "reverses": None,
+        })
+
+        for account, amount_str, amount in parsed_entries:
+            self.accounts[account]["lines"].append({
+                "txn_id": txn_id,
+                "when": when,
+                "amount": amount,
+            })
+
+        if key:
+            self.keys[key] = request
+
+        return txn_id
+
+    def reverse(self, txn_id: int, *, when: int, key: str | None = None) -> int:
+        """Reverse a transaction.
+
+        Args:
+            txn_id: id of transaction to reverse.
+            when: timestamp for reversal (must be >= original when).
+            key: optional idempotency key.
+
+        Returns:
+            id of reversal transaction.
+
+        Raises:
+            KeyError: if txn_id is unknown.
+            ValueError: if original is itself a reversal, already reversed,
+                       when is too early, or an account is closed.
+        """
+        if txn_id < 1 or txn_id > len(self.transactions):
+            raise KeyError(f"Unknown transaction: {txn_id}")
+
+        original = self.transactions[txn_id - 1]
+        if original["type"] == "reverse":
+            raise ValueError("Cannot reverse a reversal")
+
+        request = ("reverse", txn_id, when)
+        if key and key in self.keys:
+            if self.keys[key] == request:
+                reversal_id = original["reversed_by"]
+                return reversal_id
+            raise ValueError(f"Key {key} used for different request")
+
+        if original["reversed_by"] is not None:
+            raise ValueError("Transaction already reversed")
+        if when < original["when"]:
+            raise ValueError("Reversal must not precede original")
+
+        for account, _, _ in original["entries"]:
+            if self.accounts[account]["closed"]:
+                raise ValueError(f"Account is closed: {account}")
+
+        reverse_entries = [
+            (account, str(-amount))
+            for account, _, amount in original["entries"]
+        ]
+
+        reversal_id = len(self.transactions) + 1
+        self.transactions.append({
+            "id": reversal_id,
+            "type": "reverse",
+            "when": when,
+            "entries": [(a, s, Decimal(s)) for a, s in reverse_entries],
+            "reversed_by": None,
+            "reverses": txn_id,
+        })
+
+        original["reversed_by"] = reversal_id
+
+        for account, _, amount in [
+            (a, s, Decimal(s)) for a, s in reverse_entries
+        ]:
+            self.accounts[account]["lines"].append({
+                "txn_id": reversal_id,
+                "when": when,
+                "amount": amount,
+            })
+
+        if key:
+            self.keys[key] = request
+
+        return reversal_id
+
+    def balance(self, account: str, *, at: int | None = None) -> Decimal:
+        """Get account balance at a point in time.
+
+        Args:
+            account: account name.
+            at: timestamp (None = all time).
+
+        Returns:
+            balance as Decimal with correct exponent.
+
+        Raises:
+            KeyError: if account is unknown.
+        """
+        if account not in self.accounts:
+            raise KeyError(f"Unknown account: {account}")
+        currency = self.accounts[account]["currency"]
+        total = Decimal(0)
+        for line in self.accounts[account]["lines"]:
+            if at is None or line["when"] <= at:
+                total += line["amount"]
+        exponent = self.currencies[currency]
+        return Decimal(total).quantize(
+            Decimal(10) ** -exponent
+        )
+
+    def balances(self, *, at: int | None = None) -> dict[str, Decimal]:
+        """Get all nonzero account balances.
+
+        Args:
+            at: timestamp (None = all time).
+
+        Returns:
+            dict mapping account name to balance, ordered by name.
+        """
+        result = {}
+        for account in sorted(self.accounts.keys()):
+            bal = self.balance(account, at=at)
+            if bal != 0:
+                result[account] = bal
+        return result
+
+    def statement(
+        self, account: str, start: int, end: int
+    ) -> list[tuple]:
+        """Get statement lines for account in time range.
+
+        Args:
+            account: account name.
+            start: earliest timestamp (inclusive).
+            end: latest timestamp (exclusive).
+
+        Returns:
+            list of (when, txn_id, amount, running) tuples.
+
+        Raises:
+            KeyError: if account is unknown.
+            ValueError: if start > end.
+        """
+        if start > end:
+            raise ValueError("start must not exceed end")
+        if account not in self.accounts:
+            raise KeyError(f"Unknown account: {account}")
+
+        lines = self.accounts[account]["lines"]
+        sorted_lines = sorted(lines, key=lambda l: (l["when"], l["txn_id"]))
+
+        running = Decimal(0)
+        for line in sorted_lines:
+            if line["when"] < start:
+                running += line["amount"]
+
+        result = []
+        for line in sorted_lines:
+            if start <= line["when"] < end:
+                running += line["amount"]
+                currency = self.accounts[account]["currency"]
+                exponent = self.currencies[currency]
+                result.append((
+                    line["when"],
+                    line["txn_id"],
+                    line["amount"].quantize(
+                        Decimal(10) ** -exponent
+                    ),
+                    running.quantize(
+                        Decimal(10) ** -exponent
+                    ),
+                ))
+        return result
+
+    def close(self, account: str) -> None:
+        """Close an account.
+
+        Args:
+            account: account name.
+
+        Raises:
+            KeyError: if account is unknown.
+            ValueError: if already closed or balance is not zero.
+        """
+        if account not in self.accounts:
+            raise KeyError(f"Unknown account: {account}")
+        if self.accounts[account]["closed"]:
+            raise ValueError(f"Account already closed: {account}")
+        if self.balance(account) != 0:
+            raise ValueError(f"Cannot close account with nonzero balance")
+        self.accounts[account]["closed"] = True
+
+    def _parse_amount(self, amount_str: str, currency: str) -> Decimal:
+        """Parse and validate an amount string.
+
+        Args:
+            amount_str: the amount as a string.
+            currency: currency code.
+
+        Returns:
+            Decimal representation of the amount.
+
+        Raises:
+            ValueError: if amount is invalid.
+        """
+        if not isinstance(amount_str, str):
+            raise ValueError("Amount must be a string")
+        if not re.match(r"^-?\d+(\.\d+)?$", amount_str):
+            raise ValueError(f"Invalid amount format: {amount_str}")
+        decimal_amount = Decimal(amount_str)
+        if decimal_amount == 0:
+            raise ValueError("Amount cannot be zero")
+        exponent = self.currencies[currency]
+        if exponent == 0:
+            if "." in amount_str:
+                raise ValueError(
+                    f"Amount has decimal places but exponent is 0"
+                )
+        else:
+            if "." in amount_str:
+                decimal_places = len(amount_str.split(".")[1])
+                if decimal_places > exponent:
+                    raise ValueError(
+                        f"Amount has {decimal_places} places "
+                        f"but exponent is {exponent}"
+                    )
+        return -decimal_amount
+
+    def _get_txn_id_from_request(self, request):
+        """Find transaction id matching the request."""
+        for i, txn in enumerate(self.transactions):
+            if txn["type"] == "post":
+                txn_request = (
+                    "post",
+                    txn["when"],
+                    tuple(sorted([
+                        (a, s) for a, s, _ in txn["entries"]
+                    ])),
+                )
+                if txn_request == request:
+                    return txn["id"]
+        return None
