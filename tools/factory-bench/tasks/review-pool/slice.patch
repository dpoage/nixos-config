+class PreemptionTest(unittest.TestCase):
+    def test_lower_priority_is_preempted(self):
+        pool = make(root=5)
+        pool.reserve("root", 5, 0, 10, priority=0)
+        rid = pool.reserve("root", 5, 0, 10, priority=5, preempt=True)
+        self.assertEqual(rid, 2)
+        self.assertEqual(pool.status(1), "preempted")
+        self.assertEqual(pool.status(2), "active")
+        self.assertEqual(
+            pool.events(),
+            [("active", 1), ("preempted", 1), ("active", 2)],
+        )
+
+    def test_equal_priority_is_not_preempted(self):
+        pool = make(root=5)
+        pool.reserve("root", 5, 0, 10, priority=2)
+        with self.assertRaises(NoCapacity):
+            pool.reserve("root", 1, 0, 10, priority=2, preempt=True)
+        self.assertEqual(pool.status(1), "active")
+        self.assertEqual(pool.events(), [("active", 1)])
+
+    def test_only_overlapping_reservations_are_candidates(self):
+        pool = make(root=10)
+        pool.reserve("root", 5, 0, 5, priority=0)
+        pool.reserve("root", 5, 5, 10, priority=0)
+        rid = pool.reserve("root", 6, 0, 5, priority=5, preempt=True)
+        self.assertEqual(rid, 3)
+        self.assertEqual(pool.status(1), "preempted")
+        self.assertEqual(pool.status(2), "active")
+
+    def test_victim_order_is_priority_then_id_descending(self):
+        pool = make(root=5)
+        pool.reserve("root", 2, 0, 10, priority=0)
+        pool.reserve("root", 2, 0, 10, priority=1)
+        pool.reserve("root", 1, 0, 10, priority=0)
+        pool.reserve("root", 1, 0, 10, priority=5, preempt=True)
+        self.assertEqual(pool.status(3), "preempted")
+        self.assertEqual(pool.status(1), "active")
+        self.assertEqual(pool.status(2), "active")
+
+    def test_victim_order_prefers_a_later_start(self):
+        pool = make(root=5)
+        pool.reserve("root", 2, 0, 10, priority=0)
+        pool.reserve("root", 2, 2, 10, priority=0)
+        pool.reserve("root", 2, 0, 10, priority=5, preempt=True)
+        self.assertEqual(pool.status(1), "active")
+        self.assertEqual(pool.status(2), "preempted")
+
+    def test_failed_preemption_restores_everything(self):
+        pool = make(root=5)
+        pool.reserve("a", 3, 0, 5, priority=0)
+        pool.reserve("root", 5, 5, 10, priority=5)
+        before = pool.events()
+        with self.assertRaises(NoCapacity) as caught:
+            pool.reserve("root", 5, 0, 10, priority=5, preempt=True)
+        # First violation read before anything was displaced: instant 0.
+        self.assertEqual(caught.exception.node, "root")
+        self.assertEqual(caught.exception.at, 0)
+        self.assertEqual(pool.events(), before)
+        self.assertEqual(pool.status(1), "active")
+        self.assertEqual(pool.status(2), "active")
+        # No id was consumed by the failed call.
+        self.assertEqual(pool.reserve("root", 1, 20, 21), 3)
+
+    def test_failed_preemption_with_wait_creates_a_waiting_reservation(self):
+        pool = make(root=5)
+        pool.reserve("a", 3, 0, 5, priority=0)
+        pool.reserve("root", 5, 5, 10, priority=5)
+        rid = pool.reserve("root", 5, 0, 10, priority=5, preempt=True, wait=True)
+        self.assertEqual(rid, 3)
+        self.assertEqual(pool.status(3), "waiting")
+        self.assertEqual(pool.status(1), "active")
+        self.assertEqual(pool.waiting(), [3])
+
+    def test_displaced_waiting_reservation_waits_again(self):
+        pool = make(root=5)
+        pool.reserve("root", 5, 0, 10, priority=0, wait=True)
+        rid = pool.reserve("root", 5, 0, 10, priority=5, preempt=True)
+        self.assertEqual(rid, 2)
+        self.assertEqual(pool.status(1), "waiting")
+        self.assertEqual(pool.waiting(), [1])
+        self.assertEqual(
+            pool.events(),
+            [
+                ("active", 1),
+                ("preempted", 1),
+                ("waiting", 1),
+                ("active", 2),
+            ],
+        )
+
+    def test_settle_runs_after_preemption(self):
+        pool = make(root=5)
+        pool.reserve("root", 4, 0, 10, priority=3)
+        pool.reserve("root", 2, 0, 10, priority=0, wait=True)
+        rid = pool.reserve("root", 2, 0, 10, priority=5, preempt=True)
+        self.assertEqual(rid, 3)
+        self.assertEqual(pool.status(1), "preempted")
+        self.assertEqual(pool.status(2), "active")
+        self.assertEqual(
+            pool.events(),
+            [
+                ("active", 1),
+                ("waiting", 2),
+                ("preempted", 1),
+                ("active", 3),
+                ("promoted", 2),
+            ],
+        )
