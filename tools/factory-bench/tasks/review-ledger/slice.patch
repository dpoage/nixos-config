+"""Tests for the double-entry ledger."""
+
+import unittest
+from decimal import Decimal
+
+from ledger import Ledger
+
+
+def usd_ledger():
+    ledger = Ledger({"USD": 2, "JPY": 0})
+    for account in ("bank", "cash", "equity", "fee"):
+        ledger.open(account, "USD")
+    for account in ("jpy", "jpy2", "jpy3"):
+        ledger.open(account, "JPY")
+    return ledger
+
+
+def places(value):
+    return value.as_tuple().exponent
+
+
+class TestSetup(unittest.TestCase):
+    """Property 1: currency exponents, unknown currencies, duplicate accounts."""
+
+    def test_negative_exponent_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            Ledger({"USD": -1})
+
+    def test_zero_exponent_is_allowed(self):
+        ledger = Ledger({"JPY": 0})
+        ledger.open("jpy", "JPY")
+        self.assertEqual(ledger.balance("jpy"), Decimal("0"))
+
+    def test_open_unknown_currency_raises_key_error(self):
+        ledger = Ledger({"USD": 2})
+        with self.assertRaises(KeyError):
+            ledger.open("cash", "EUR")
+        # The failed open left nothing behind.
+        ledger.open("cash", "USD")
+        self.assertEqual(ledger.balance("cash"), Decimal("0.00"))
+
+    def test_second_open_raises_value_error(self):
+        ledger = Ledger({"USD": 2})
+        ledger.open("cash", "USD")
+        with self.assertRaises(ValueError):
+            ledger.open("cash", "USD")
+        self.assertEqual(ledger.balance("cash"), Decimal("0.00"))
+
+    def test_second_open_in_another_currency_raises_value_error(self):
+        ledger = Ledger({"USD": 2, "JPY": 0})
+        ledger.open("cash", "USD")
+        with self.assertRaises(ValueError):
+            ledger.open("cash", "JPY")
+        self.assertEqual(ledger.balance("cash"), Decimal("0.00"))
+
+
+class TestPostingAtomic(unittest.TestCase):
+    """Property 2: a rejected post raises, changes nothing, and uses no id."""
+
+    def assert_untouched(self, ledger):
+        self.assertEqual(ledger.balances(), {})
+        self.assertEqual(ledger.statement("cash", 0, 100), [])
+        self.assertEqual(ledger.statement("bank", 0, 100), [])
+
+    def test_unknown_account_raises_key_error(self):
+        ledger = usd_ledger()
+        with self.assertRaises(KeyError):
+            ledger.post([("cash", "5"), ("nope", "-5")], when=1)
+        self.assert_untouched(ledger)
+        self.assertEqual(ledger.post([("cash", "5"), ("bank", "-5")], when=1), 1)
+
+    def test_invalid_amounts_raise_value_error(self):
+        bad_amounts = ["5.000", "+5", "1e2", "0.00", 5, "abc", "", "5.", ".5", "-0"]
+        for bad in bad_amounts:
+            with self.subTest(amount=bad):
+                ledger = usd_ledger()
+                with self.assertRaises(ValueError):
+                    ledger.post([("cash", bad), ("bank", "-5")], when=1)
+                self.assert_untouched(ledger)
+                self.assertEqual(
+                    ledger.post([("cash", "5"), ("bank", "-5")], when=1), 1
+                )
+
+    def test_boundary_amounts_are_valid(self):
+        for good in ("5", "5.0", "-5.25", "0.01", "5.25", "5.00"):
+            with self.subTest(amount=good):
+                ledger = usd_ledger()
+                other = good[1:] if good.startswith("-") else "-" + good
+                self.assertEqual(
+                    ledger.post([("cash", good), ("bank", other)], when=1), 1
+                )
+
+    def test_fewer_than_two_entries_raises_value_error(self):
+        ledger = usd_ledger()
+        for entries in ([], [("cash", "5")]):
+            with self.subTest(entries=entries):
+                with self.assertRaises(ValueError):
+                    ledger.post(entries, when=1)
+                self.assert_untouched(ledger)
+        self.assertEqual(ledger.post([("cash", "5"), ("bank", "-5")], when=1), 1)
+
+    def test_post_to_closed_account_raises_value_error(self):
+        ledger = usd_ledger()
+        ledger.close("cash")
+        with self.assertRaises(ValueError):
+            ledger.post([("cash", "5"), ("bank", "-5")], when=1)
+        self.assert_untouched(ledger)
+        self.assertEqual(ledger.post([("bank", "5"), ("equity", "-5")], when=1), 1)
+
+    def test_unbalanced_currency_raises_value_error(self):
+        ledger = usd_ledger()
+        with self.assertRaises(ValueError):
+            ledger.post([("cash", "5"), ("bank", "-4")], when=1)
+        self.assert_untouched(ledger)
+        self.assertEqual(ledger.post([("cash", "5"), ("bank", "-5")], when=1), 1)
+
+    def test_balance_is_checked_per_currency(self):
+        # Each currency is unbalanced even though the grand total is zero.
+        ledger = usd_ledger()
+        with self.assertRaises(ValueError):
+            ledger.post([("cash", "5"), ("jpy", "-5")], when=1)
+        self.assert_untouched(ledger)
+        self.assertEqual(
+            ledger.post(
+                [
+                    ("cash", "5"),
+                    ("bank", "-5"),
+                    ("jpy", "3"),
+                    ("jpy2", "-3"),
+                ],
+                when=1,
+            ),
+            1,
+        )
+
+    def test_balanced_multi_currency_post_is_accepted(self):
+        ledger = usd_ledger()
+        txn_id = ledger.post(
+            [("cash", "5"), ("bank", "-5"), ("jpy", "3"), ("jpy2", "-3")], when=1
+        )
+        self.assertEqual(txn_id, 1)
+        self.assertEqual(ledger.balance("cash"), Decimal("5.00"))
+        self.assertEqual(ledger.balance("jpy"), Decimal("3"))
+
+    def test_unknown_account_wins_over_other_faults(self):
+        ledger = usd_ledger()
+        cases = [
+            [("nope", "5"), ("cash", "5"), ("bank", "5")],  # also unbalanced
+            [("nope", "5"), ("cash", "bad"), ("bank", "-5")],  # also invalid amount
+            [("nope", "5"), ("cash", "5")],  # also fewer than two real entries
+        ]
+        for entries in cases:
+            with self.subTest(entries=entries):
+                with self.assertRaises(KeyError):
+                    ledger.post(entries, when=1)
+                self.assert_untouched(ledger)
+
+    def test_failed_posts_use_no_ids(self):
+        ledger = usd_ledger()
+        attempts = [
+            [("cash", "5"), ("nope", "-5")],
+            [("cash", "5.000"), ("bank", "-5")],
+            [("cash", "5")],
+            [("cash", "5"), ("bank", "-4")],
+        ]
+        for entries in attempts:
+            with self.assertRaises((KeyError, ValueError)):
+                ledger.post(entries, when=1)
+        self.assertEqual(ledger.post([("cash", "5"), ("bank", "-5")], when=1), 1)
+
+    def test_repeated_account_entries_form_one_line(self):
+        ledger = usd_ledger()
+        self.assertEqual(
+            ledger.post([("cash", "5"), ("cash", "2"), ("bank", "-7")], when=1), 1
+        )
+        self.assertEqual(ledger.balance("cash"), Decimal("7.00"))
+        rows = ledger.statement("cash", 0, 10)
+        self.assertEqual(len(rows), 1)
+        self.assertEqual(rows[0][2], Decimal("7.00"))
+
+    def test_entries_netting_to_zero_for_an_account_are_accepted(self):
+        ledger = usd_ledger()
+        self.assertEqual(
+            ledger.post(
+                [
+                    ("cash", "5"),
+                    ("cash", "-5"),
+                    ("bank", "5"),
+                    ("bank", "-5"),
+                ],
+                when=1,
+            ),
+            1,
+        )
+        self.assertEqual(ledger.balance("cash"), Decimal("0.00"))
+        self.assertEqual(ledger.statement("cash", 0, 10), [])
+
+
+class TestExponent(unittest.TestCase):
+    """Property 3: balances carry exactly their currency's decimal places."""
+
+    def test_new_usd_balance_keeps_two_places(self):
+        ledger = usd_ledger()
+        value = ledger.balance("cash")
+        self.assertEqual(value, Decimal("0.00"))
+        self.assertEqual(places(value), -2)
+
+    def test_new_jpy_balance_keeps_no_places(self):
+        ledger = usd_ledger()
+        value = ledger.balance("jpy")
+        self.assertEqual(value, Decimal("0"))
+        self.assertEqual(places(value), 0)
+
+    def test_four_place_currency(self):
+        ledger = Ledger({"GBP": 4})
+        ledger.open("cash", "GBP")
+        value = ledger.balance("cash")
+        self.assertEqual(value, Decimal("0.0000"))
+        self.assertEqual(places(value), -4)
+
+    def test_posted_balance_keeps_exponent(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5.5"), ("bank", "-5.5")], when=1)
+        value = ledger.balance("cash")
+        self.assertEqual(value, Decimal("5.50"))
+        self.assertEqual(places(value), -2)
+
+    def test_integer_spelling_still_keeps_exponent(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1)
+        value = ledger.balance("cash")
+        self.assertEqual(places(value), -2)
+
+    def test_balances_carry_exponent(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5"), ("jpy", "3"), ("jpy2", "-3")], when=1)
+        values = ledger.balances()
+        self.assertEqual(places(values["cash"]), -2)
+        self.assertEqual(places(values["jpy"]), 0)
+
+
+class TestDatedBalance(unittest.TestCase):
+    """Property 4: balance(at=t) sums lines in transactions with when <= t."""
+
+    def test_boundary_is_inclusive(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=10)
+        self.assertEqual(ledger.balance("cash", at=9), Decimal("0.00"))
+        self.assertEqual(ledger.balance("cash", at=10), Decimal("5.00"))
+        self.assertEqual(ledger.balance("cash", at=11), Decimal("5.00"))
+
+    def test_acceptance_order_does_not_matter(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=10)
+        ledger.post([("cash", "3"), ("bank", "-3")], when=5)
+        self.assertEqual(ledger.balance("cash", at=4), Decimal("0.00"))
+        self.assertEqual(ledger.balance("cash", at=5), Decimal("3.00"))
+        self.assertEqual(ledger.balance("cash", at=9), Decimal("3.00"))
+        self.assertEqual(ledger.balance("cash", at=10), Decimal("8.00"))
+        self.assertEqual(ledger.balance("cash"), Decimal("8.00"))
+
+
