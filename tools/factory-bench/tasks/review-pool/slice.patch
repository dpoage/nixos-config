@@ -0,0 +1,590 @@
+import unittest
+
+from pool import NoCapacity, Pool
+
+TREE = {"root": None, "a": "root", "b": "root", "a1": "a", "a2": "a"}
+
+
+def quotas(**overrides):
+    base = {"root": 10, "a": 10, "b": 10, "a1": 10, "a2": 10}
+    base.update(overrides)
+    return base
+
+
+def make(**overrides):
+    return Pool(TREE, quotas(**overrides))
+
+
+class SetupTest(unittest.TestCase):
+    def test_rejects_bad_trees(self):
+        cases = [
+            ({}, {}),
+            ({"r": None, "s": None}, {"r": 0, "s": 0}),
+            ({"r": None, "x": "missing"}, {"r": 0, "x": 0}),
+            ({"r": None, "a": "b", "b": "a"}, {"r": 0, "a": 0, "b": 0}),
+            ({"r": None, "a": "a"}, {"r": 0, "a": 0}),
+            ({"r": None}, {"r": 0, "extra": 0}),
+            ({"r": None}, {}),
+        ]
+        for tree, tree_quotas in cases:
+            with self.subTest(tree=tree, quotas=tree_quotas):
+                with self.assertRaises(ValueError):
+                    Pool(tree, tree_quotas)
+
+    def test_rejects_bad_quotas(self):
+        for quota in (True, -1, 1.0, "1", None):
+            with self.subTest(quota=quota):
+                with self.assertRaises(ValueError):
+                    Pool({"r": None}, {"r": quota})
+
+    def test_accepts_a_zero_quota(self):
+        pool = Pool({"r": None}, {"r": 0})
+        self.assertEqual(pool.usage("r", 0), 0)
+
+    def test_rejects_a_quota_of_true(self):
+        with self.assertRaises(ValueError):
+            Pool({"r": None}, {"r": True})
+
+
+class ValidationTest(unittest.TestCase):
+    def setUp(self):
+        self.pool = make()
+
+    def test_unknown_node_is_key_error_even_with_other_bad_arguments(self):
+        with self.assertRaises(KeyError):
+            self.pool.reserve("nope", 1, 0, 1)
+        with self.assertRaises(KeyError):
+            self.pool.reserve("nope", 0, 5, 5)
+
+    def test_rejects_bad_units(self):
+        for units in (0, -1, True, 1.0, "1"):
+            with self.subTest(units=units):
+                with self.assertRaises(ValueError):
+                    self.pool.reserve("root", units, 0, 1)
+
+    def test_rejects_bad_instants(self):
+        for start, end in (
+            (True, 1),
+            (0, True),
+            (1.0, 2),
+            (0, 1.0),
+            ("0", 1),
+            (0, "1"),
+        ):
+            with self.subTest(start=start, end=end):
+                with self.assertRaises(ValueError):
+                    self.pool.reserve("root", 1, start, end)
+
+    def test_rejects_empty_and_reversed_intervals(self):
+        with self.assertRaises(ValueError):
+            self.pool.reserve("root", 1, 5, 5)
+        with self.assertRaises(ValueError):
+            self.pool.reserve("root", 1, 6, 5)
+
+    def test_accepts_boundary_values(self):
+        pool = make()
+        self.assertEqual(pool.reserve("root", 1, 0, 1, priority=9), 1)
+        self.assertEqual(pool.reserve("root", 1, 1, 2, priority=0), 2)
+
+    def test_rejects_bad_priority(self):
+        for priority in (10, -1, True, 1.5, "0"):
+            with self.subTest(priority=priority):
+                with self.assertRaises(ValueError):
+                    self.pool.reserve("root", 1, 0, 1, priority=priority)
+
+
+class CapacityTest(unittest.TestCase):
+    def test_fitting_request_is_active(self):
+        pool = make(root=5)
+        rid = pool.reserve("root", 5, 0, 5)
+        self.assertEqual(rid, 1)
+        self.assertEqual(pool.status(rid), "active")
+        self.assertEqual(pool.events(), [("active", 1)])
+        self.assertEqual(pool.usage("root", 0), 5)
+
+    def test_usage_may_equal_a_quota(self):
+        pool = make(root=9, a=5, b=4)
+        self.assertEqual(pool.reserve("a", 5, 0, 5), 1)
+        self.assertEqual(pool.reserve("b", 4, 0, 5), 2)
+        self.assertEqual(pool.usage("root", 0), 9)
+
+    def test_every_ancestor_limits_the_request(self):
+        pool = make(root=8, a=6, b=6)
+        self.assertEqual(pool.reserve("a", 5, 0, 5), 1)
+        with self.assertRaises(NoCapacity):
+            pool.reserve("b", 4, 0, 5)
+        self.assertEqual(pool.events(), [("active", 1)])
+        # No id was consumed by the rejected call.
+        self.assertEqual(pool.reserve("b", 3, 0, 5), 2)
+
+
+class NoCapacityTest(unittest.TestCase):
+    def test_reports_the_nearest_violation(self):
+        pool = make(root=4, a1=4)
+        pool.reserve("a1", 3, 5, 9)
+        before = pool.events()
+        with self.assertRaises(NoCapacity) as caught:
+            pool.reserve("a1", 2, 0, 10)
+        error = caught.exception
+        self.assertEqual(error.node, "a1")
+        self.assertEqual(error.at, 5)
+        self.assertIn("a1", str(error))
+        self.assertIn("5", str(error))
+        self.assertEqual(pool.events(), before)
+        self.assertEqual(pool.status(1), "active")
+        # No id was consumed.
+        self.assertEqual(pool.reserve("root", 1, 0, 1), 2)
+
+    def test_nothing_changes_on_failure(self):
+        pool = make(root=5)
+        pool.reserve("root", 5, 0, 10)
+        before = pool.events()
+        with self.assertRaises(NoCapacity):
+            pool.reserve("root", 1, 0, 10)
+        self.assertEqual(pool.events(), before)
+        self.assertEqual(pool.usage("root", 0), 5)
+
+
+class QueriesTest(unittest.TestCase):
+    def test_usage_is_subtree_and_half_open(self):
+        pool = make()
+        pool.reserve("a1", 2, 0, 5)
+        self.assertEqual(pool.usage("a1", 0), 2)
+        self.assertEqual(pool.usage("a", 4), 2)
+        self.assertEqual(pool.usage("root", 0), 2)
+        self.assertEqual(pool.usage("a1", 5), 0)
+        self.assertEqual(pool.usage("b", 0), 0)
+
+    def test_usage_ignores_waiting_reservations(self):
+        pool = make(root=1)
+        pool.reserve("root", 1, 0, 10)
+        pool.reserve("root", 1, 0, 10, wait=True)
+        self.assertEqual(pool.usage("root", 0), 1)
+
+    def test_peak_excludes_the_end_instant(self):
+        pool = make()
+        pool.reserve("root", 2, 0, 5)
+        pool.reserve("root", 3, 5, 9)
+        self.assertEqual(pool.peak("root", 0, 5), 2)
+        self.assertEqual(pool.peak("root", 0, 9), 3)
+        self.assertEqual(pool.peak("root", 5, 9), 3)
+        self.assertEqual(pool.peak("root", 9, 10), 0)
+        with self.assertRaises(ValueError):
+            pool.peak("root", 5, 5)
+        with self.assertRaises(ValueError):
+            pool.peak("root", 6, 5)
+
+    def test_peak_for_a_leaf_ignores_siblings(self):
+        pool = make()
+        pool.reserve("a", 4, 0, 5)
+        self.assertEqual(pool.peak("b", 0, 5), 0)
+
+    def test_timeline_lists_change_instants(self):
+        pool = make()
+        pool.reserve("root", 2, 0, 5)
+        pool.reserve("root", 3, 5, 9)
+        self.assertEqual(pool.timeline("root"), [(0, 2), (5, 3), (9, 0)])
+
+    def test_timeline_skips_cancelling_changes(self):
+        pool = make()
+        pool.reserve("root", 2, 0, 5)
+        pool.reserve("root", 2, 5, 9)
+        self.assertEqual(pool.timeline("root"), [(0, 2), (9, 0)])
+
+    def test_timeline_is_empty_without_active_reservations(self):
+        pool = make()
+        self.assertEqual(pool.timeline("root"), [])
+        pool.reserve("a1", 2, 0, 5)
+        self.assertEqual(pool.timeline("b"), [])
+        self.assertEqual(pool.timeline("a2"), [])
+
+    def test_timeline_follows_the_subtree(self):
+        pool = make()
+        pool.reserve("a1", 2, 0, 5)
+        self.assertEqual(pool.timeline("a"), [(0, 2), (5, 0)])
+        self.assertEqual(pool.timeline("a1"), [(0, 2), (5, 0)])
+        pool.cancel(1)
+        self.assertEqual(pool.timeline("a"), [])
+
