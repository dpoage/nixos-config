+class TestReversal(unittest.TestCase):
+    """Property 8: reversals negate lines and refuse invalid requests."""
+
+    def test_reverse_negates_lines(self):
+        ledger = usd_ledger()
+        original = ledger.post([("cash", "5"), ("bank", "-5")], when=10)
+        self.assertEqual(ledger.reverse(original, when=10), 2)
+        self.assertEqual(ledger.balance("cash"), Decimal("0.00"))
+        self.assertEqual(ledger.balance("bank"), Decimal("0.00"))
+
+    def test_reverse_of_unknown_id_raises_key_error(self):
+        ledger = usd_ledger()
+        with self.assertRaises(KeyError):
+            ledger.reverse(99, when=1)
+        self.assertEqual(ledger.post([("cash", "5"), ("bank", "-5")], when=1), 1)
+
+    def test_reverse_of_reversal_raises(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1)
+        ledger.reverse(1, when=1)
+        with self.assertRaises(ValueError):
+            ledger.reverse(2, when=1)
+
+    def test_second_reversal_raises(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1)
+        ledger.reverse(1, when=1)
+        with self.assertRaises(ValueError):
+            ledger.reverse(1, when=2)
+        self.assertEqual(ledger.balance("cash"), Decimal("0.00"))
+        self.assertEqual(ledger.balance("bank"), Decimal("0.00"))
+
+    def test_when_below_original_raises(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=10)
+        with self.assertRaises(ValueError):
+            ledger.reverse(1, when=9)
+        self.assertEqual(ledger.balance("cash"), Decimal("5.00"))
+        self.assertEqual(ledger.reverse(1, when=11), 2)
+
+    def test_closed_account_blocks_reversal(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1)
+        ledger.post([("cash", "-5"), ("equity", "5")], when=2)
+        ledger.close("cash")
+        with self.assertRaises(ValueError):
+            ledger.reverse(1, when=2)
+        self.assertEqual(ledger.balance("cash"), Decimal("0.00"))
+        self.assertEqual(ledger.post([("bank", "1"), ("equity", "-1")], when=3), 3)
+
+    def test_failed_reversal_uses_no_id(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1)
+        ledger.reverse(1, when=1)
+        for attempt in (lambda: ledger.reverse(1, when=2), lambda: ledger.reverse(2, when=2)):
+            with self.assertRaises(ValueError):
+                attempt()
+        self.assertEqual(ledger.post([("cash", "1"), ("bank", "-1")], when=3), 3)
+
+    def test_reversal_negates_only_the_originals_lines(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("cash", "2"), ("bank", "-7")], when=1)
+        ledger.reverse(1, when=1)
+        self.assertEqual(ledger.balance("cash"), Decimal("0.00"))
+        self.assertEqual(ledger.balance("bank"), Decimal("0.00"))
+        rows = ledger.statement("cash", 0, 10)
+        self.assertEqual([row[2] for row in rows], [Decimal("7.00"), Decimal("-7.00")])
