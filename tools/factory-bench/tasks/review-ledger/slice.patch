-"""Double-entry ledger. Not implemented yet."""
+"""A double-entry ledger that holds several currencies.
+
+Amounts are strings so that every value keeps the number of decimal places its
+currency allows.  Each currency has an exponent: the number of decimal places it
+keeps (USD 2, JPY 0).  A positive amount is a debit, a negative amount a credit,
+and every transaction balances to zero within each currency separately.
+"""
+
+from __future__ import annotations
+
+import re
+from decimal import Decimal
+
+__all__ = ["Ledger"]
+
+_AMOUNT_RE = re.compile(r"-?\d+(?:\.\d+)?")
+
+
+def _quantum(exponent: int) -> Decimal:
+    """The value of one unit in the last decimal place a currency keeps."""
+    return Decimal(1).scaleb(-exponent)
+
+
+def _parse_amount(amount, exponent: int) -> Decimal:
+    """Return the exact value of a valid amount, else raise ``ValueError``."""
+    if not isinstance(amount, str):
+        raise ValueError("amount must be a string: %r" % (amount,))
+    if _AMOUNT_RE.fullmatch(amount) is None:
+        raise ValueError("invalid amount: %r" % (amount,))
+    point = amount.find(".")
+    places = 0 if point < 0 else len(amount) - point - 1
+    if places > exponent:
+        raise ValueError(
+            "amount %r has more decimal places than its currency allows" % (amount,)
+        )
+    value = Decimal(amount)
+    if value == 0:
+        raise ValueError("amount must not be zero: %r" % (amount,))
+    return value
+
+
+class _Account:
+    __slots__ = ("currency", "closed")
+
+    def __init__(self, currency: str) -> None:
+        self.currency = currency
+        self.closed = False
+
+
+class _Transaction:
+    __slots__ = ("id", "when", "lines", "reversal", "reversed_by")
+
+    def __init__(self, txn_id: int, when: int, lines: dict, reversal: bool) -> None:
+        self.id = txn_id
+        self.when = when
+        self.lines = lines
+        self.reversal = reversal
+        self.reversed_by = None
 
 
 class Ledger:
-    def __init__(self, currencies):
-        raise NotImplementedError
+    """A ledger of accounts in fixed currencies, written in balanced transactions."""
+
+    def __init__(self, currencies: dict[str, int]):
+        self._currencies: dict[str, int] = {}
+        for code, exponent in currencies.items():
+            if not isinstance(exponent, int) or isinstance(exponent, bool):
+                raise TypeError("currency exponent must be an int: %r" % (code,))
+            if exponent < 0:
+                raise ValueError("currency %r has a negative exponent" % (code,))
+            self._currencies[code] = exponent
+        self._accounts: dict[str, _Account] = {}
+        self._transactions: list[_Transaction] = []
+        self._keys: dict[str, tuple[int, tuple]] = {}
+
+    # -- setup -----------------------------------------------------------------
+
+    def open(self, account: str, currency: str) -> None:
+        if currency not in self._currencies:
+            raise KeyError(currency)
+        if account in self._accounts:
+            raise ValueError("account already exists: %r" % (account,))
+        self._accounts[account] = _Account(currency)
+
+    # -- posting ---------------------------------------------------------------
+
+    @staticmethod
+    def _entry_pairs(entries):
+        try:
+            items = list(entries)
+        except TypeError:
+            raise ValueError("entries must be an iterable of pairs") from None
+        pairs = []
+        for item in items:
+            try:
+                account, amount = item
+            except (TypeError, ValueError):
+                raise ValueError("each entry must be an (account, amount) pair") from None
+            pairs.append((account, amount))
+        return pairs
+
+    @staticmethod
+    def _request_signature(pairs):
+        """The multiset form of a post request: ``when`` is added by the caller."""
+        items = []
+        for account, amount in pairs:
+            if not isinstance(amount, str):
+                raise ValueError("amount must be a string: %r" % (amount,))
+            if _AMOUNT_RE.fullmatch(amount) is None:
+                raise ValueError("invalid amount: %r" % (amount,))
+            items.append((account, Decimal(amount)))
+        try:
+            return tuple(sorted(items))
+        except TypeError:
+            # Account names that do not sort still compare as a multiset of reprs.
+            return tuple(sorted((repr(account), value) for account, value in items))
+
+    def _lookup_key(self, key, signature):
+        """Return the id a reused key already claimed, or ``None``."""
+        if key is None or key not in self._keys:
+            return None
+        txn_id, claimed = self._keys[key]
+        if claimed != signature:
+            raise ValueError("key %r was already used for a different request" % (key,))
+        return txn_id
+
+    def post(self, entries, *, when: int, key: str | None = None) -> int:
+        pairs = self._entry_pairs(entries)
+        for account, _amount in pairs:
+            if account not in self._accounts:
+                raise KeyError(account)
+        signature = ("post", when, self._request_signature(pairs))
+        replayed = self._lookup_key(key, signature)
+        if replayed is not None:
+            return replayed
+        if len(pairs) < 2:
+            raise ValueError("a transaction needs at least two entries")
+        values: dict[str, Decimal] = {}
+        for account, amount in pairs:
+            exponent = self._currencies[self._accounts[account].currency]
+            value = _parse_amount(amount, exponent)
+            values[account] = values.get(account, Decimal(0)) + value
+        for account in values:
+            if self._accounts[account].closed:
+                raise ValueError("account is closed: %r" % (account,))
+        totals: dict[str, Decimal] = {}
+        for account, value in values.items():
+            currency = self._accounts[account].currency
+            totals[currency] = totals.get(currency, Decimal(0)) + value
+        for currency, total in totals.items():
+            if total != 0:
+                raise ValueError("entries in %r do not sum to zero" % (currency,))
+        lines = {account: value for account, value in values.items() if value != 0}
+        txn_id = self._accept(when, lines, reversal=False)
+        if key is not None:
+            self._keys[key] = (txn_id, signature)
+        return txn_id
+
+    def _accept(self, when: int, lines: dict, *, reversal: bool) -> int:
+        txn_id = len(self._transactions) + 1
+        self._transactions.append(_Transaction(txn_id, when, lines, reversal))
+        return txn_id
+
+    def _transaction(self, txn_id) -> _Transaction:
+        if (
+            not isinstance(txn_id, int)
+            or isinstance(txn_id, bool)
+            or not 1 <= txn_id <= len(self._transactions)
+        ):
+            raise KeyError(txn_id)
+        return self._transactions[txn_id - 1]
+
+    def reverse(self, txn_id: int, *, when: int, key: str | None = None) -> int:
+        signature = ("reverse", when, txn_id)
+        replayed = self._lookup_key(key, signature)
+        if replayed is not None:
+            return replayed
+        txn = self._transaction(txn_id)
+        if txn.reversal:
+            raise ValueError("cannot reverse a reversal: %r" % (txn_id,))
+        if txn.reversed_by is not None:
+            raise ValueError("transaction %r was already reversed" % (txn_id,))
+        if when < txn.when:
+            raise ValueError("a reversal cannot precede the original transaction")
+        for account in txn.lines:
+            if self._accounts[account].closed:
+                raise ValueError("account is closed: %r" % (account,))
+        lines = {account: -value for account, value in txn.lines.items()}
+        new_id = self._accept(when, lines, reversal=True)
+        txn.reversed_by = new_id
+        if key is not None:
+            self._keys[key] = (new_id, signature)
+        return new_id
+
+    # -- queries ---------------------------------------------------------------
+
+    def _account(self, account: str) -> _Account:
+        found = self._accounts.get(account)
+        if found is None:
+            raise KeyError(account)
+        return found
+
+    def balance(self, account: str, *, at: int | None = None) -> Decimal:
+        found = self._account(account)
+        total = Decimal(0)
+        for txn in self._transactions:
+            if at is not None and txn.when > at:
+                continue
+            value = txn.lines.get(account)
+            if value is not None:
+                total += value
+        return total.quantize(_quantum(self._currencies[found.currency]))
+
+    def balances(self, *, at: int | None = None) -> dict[str, Decimal]:
+        result: dict[str, Decimal] = {}
+        for account in sorted(self._accounts):
+            value = self.balance(account, at=at)
+            if value != 0:
+                result[account] = value
+        return result
+
+    def statement(self, account: str, start: int, end: int) -> list[tuple]:
+        found = self._account(account)
+        if start > end:
+            raise ValueError("start must not be greater than end")
+        quantum = _quantum(self._currencies[found.currency])
+        running = Decimal(0)
+        rows: list[tuple] = []
+        for txn in sorted(self._transactions, key=lambda t: (t.when, t.id)):
+            value = txn.lines.get(account)
+            if value is None:
+                continue
+            running += value
+            if start <= txn.when < end:
+                rows.append(
+                    (txn.when, txn.id, value.quantize(quantum), running.quantize(quantum))
+                )
+        return rows
+
+    # -- lifecycle -------------------------------------------------------------
+
+    def close(self, account: str) -> None:
+        found = self._account(account)
+        if found.closed:
+            raise ValueError("account is already closed: %r" % (account,))
+        if self.balance(account) != 0:
+            raise ValueError("account balance is not zero: %r" % (account,))
+        found.closed = True
