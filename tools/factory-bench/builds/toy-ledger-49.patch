+import unittest
+from decimal import Decimal
+from ledger import Ledger
+
+
+class TestSetup(unittest.TestCase):
+    """Property 1: Setup. Currency exponent below zero raises ValueError. 
+    open raises KeyError for unknown currency and ValueError for existing account.
+    Mutant: accept a second open of one account.
+    """
+    
+    def test_negative_exponent_raises(self):
+        """Negative exponent should raise ValueError."""
+        with self.assertRaises(ValueError):
+            Ledger({"USD": -1})
+    
+    def test_zero_exponent_ok(self):
+        """Zero exponent should be allowed."""
+        ledger = Ledger({"JPY": 0})
+        self.assertIsNotNone(ledger)
+    
+    def test_open_unknown_currency_raises_keyerror(self):
+        """Opening account with unknown currency raises KeyError."""
+        ledger = Ledger({"USD": 2})
+        with self.assertRaises(KeyError):
+            ledger.open("cash", "EUR")
+    
+    def test_open_existing_account_raises_valueerror(self):
+        """Opening same account twice raises ValueError."""
+        ledger = Ledger({"USD": 2})
+        ledger.open("cash", "USD")
+        with self.assertRaises(ValueError):
+            ledger.open("cash", "USD")
+    
+    def test_open_first_account_succeeds(self):
+        """Opening first account should succeed."""
+        ledger = Ledger({"USD": 2})
+        ledger.open("cash", "USD")
+        # Should not raise
+
+
+class TestPosting(unittest.TestCase):
+    """Property 2: Posting is atomic. Raises and changes nothing when:
+    - account is unknown (KeyError)
+    - amount is invalid
+    - fewer than 2 entries
+    - account is closed
+    - entries don't sum to zero per currency
+    When both unknown account and another fault present, raises KeyError.
+    Mutant: check sum across all currencies together.
+    """
+    
+    def setUp(self):
+        self.ledger = Ledger({"USD": 2})
+        self.ledger.open("cash", "USD")
+        self.ledger.open("checking", "USD")
+    
+    def test_fewer_than_two_entries_raises(self):
+        """Transaction with <2 entries raises ValueError."""
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "5")], when=1)
+    
+    def test_unknown_account_raises_keyerror(self):
+        """Unknown account raises KeyError."""
+        with self.assertRaises(KeyError):
+            self.ledger.post([("cash", "5"), ("unknown", "-5")], when=1)
+    
+    def test_invalid_amount_format_raises(self):
+        """Invalid amount format raises ValueError."""
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "+5"), ("checking", "-5")], when=1)
+    
+    def test_zero_amount_raises(self):
+        """Zero amount raises ValueError."""
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "0"), ("checking", "-0")], when=1)
+    
+    def test_amount_too_many_decimals_raises(self):
+        """Amount with more decimals than exponent raises ValueError."""
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "5.000"), ("checking", "-5.000")], when=1)
+    
+    def test_unbalanced_entries_raises(self):
+        """Unbalanced entries raise ValueError."""
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "5"), ("checking", "-3")], when=1)
+    
+    def test_valid_transaction_succeeds(self):
+        """Valid balanced transaction succeeds."""
+        txn_id = self.ledger.post([("cash", "5"), ("checking", "-5")], when=1)
+        self.assertEqual(txn_id, 1)
+    
+    def test_keyerror_takes_precedence(self):
+        """KeyError for unknown account takes precedence over other errors."""
+        with self.assertRaises(KeyError):
+            # Unknown account AND unbalanced
+            self.ledger.post([("unknown", "5"), ("checking", "-3")], when=1)
+    
+    def test_closed_account_raises(self):
+        """Posting to closed account raises ValueError."""
+        # Create balanced transaction
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=1)
+        # Reverse it to get zero balance
+        self.ledger.reverse(1, when=2)
+        # Close cash
+        self.ledger.close("cash")
+        # Try to post to closed account
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "10"), ("checking", "-10")], when=3)
+    
+    def test_per_currency_balance_not_global(self):
+        """Balance is checked per currency, not globally."""
+        ledger = Ledger({"USD": 2, "EUR": 2})
+        ledger.open("usd_a", "USD")
+        ledger.open("usd_b", "USD")
+        ledger.open("eur_a", "EUR")
+        ledger.open("eur_b", "EUR")
+        # This should succeed: USD balances and EUR balances separately
+        txn_id = ledger.post([
+            ("usd_a", "5"),
+            ("usd_b", "-5"),
+            ("eur_a", "3"),
+            ("eur_b", "-3")
+        ], when=1)
+        self.assertEqual(txn_id, 1)
+    
+    def test_per_currency_unbalance_fails(self):
+        """Unbalanced per-currency entries fail."""
+        ledger = Ledger({"USD": 2, "EUR": 2})
+        ledger.open("usd_account", "USD")
+        ledger.open("eur_account", "EUR")
+        # This should fail: USD doesn't balance
+        with self.assertRaises(ValueError):
+            ledger.post([
+                ("usd_account", "5"),
+                ("usd_account", "3"),
+                ("eur_account", "-8")
+            ], when=1)
+
+
+class TestAmountPrecision(unittest.TestCase):
+    """Property 3: Amounts keep their exponent.
+    balance returns Decimal with exactly exponent's decimal places.
+    Mutant: return Decimal(0) for account with no lines.
+    """
+    
+    def test_usd_balance_has_two_decimals(self):
+        """USD balance should have exactly 2 decimal places."""
+        ledger = Ledger({"USD": 2})
+        ledger.open("cash", "USD")
+        balance = ledger.balance("cash")
+        self.assertEqual(balance, Decimal("0.00"))
+        self.assertEqual(str(balance), "0.00")
+    
+    def test_jpy_balance_has_zero_decimals(self):
+        """JPY balance should have zero decimal places."""
+        ledger = Ledger({"JPY": 0})
+        ledger.open("cash", "JPY")
+        balance = ledger.balance("cash")
+        self.assertEqual(balance, Decimal("0"))
+        self.assertEqual(str(balance), "0")
+    
+    def test_balance_maintains_exponent_after_post(self):
+        """Balance maintains exponent after posting."""
+        ledger = Ledger({"USD": 2})
+        ledger.open("cash", "USD")
+        ledger.open("checking", "USD")
+        ledger.post([("cash", "5"), ("checking", "-5")], when=1)
+        balance = ledger.balance("cash")
+        self.assertEqual(balance, Decimal("5.00"))
+        self.assertEqual(str(balance), "5.00")
+
+
+class TestDatedBalance(unittest.TestCase):
+    """Property 4: Dated balance. 
+    balance(account, at=t) is sum of account's lines in transactions with when <= t.
+    at=None means all. Transactions may be accepted in any order of when.
+    Mutant: use < instead of <=.
+    """
+    
+    def setUp(self):
+        self.ledger = Ledger({"USD": 2})
+        self.ledger.open("cash", "USD")
+        self.ledger.open("checking", "USD")
+    
+    def test_balance_at_specific_time(self):
+        """Balance at specific time includes transactions with when <= at."""
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=10)
+        self.ledger.post([("cash", "3"), ("checking", "-3")], when=20)
+        
+        balance_at_10 = self.ledger.balance("cash", at=10)
+        self.assertEqual(balance_at_10, Decimal("5.00"))
+        
+        balance_at_20 = self.ledger.balance("cash", at=20)
+        self.assertEqual(balance_at_20, Decimal("8.00"))
+    
+    def test_balance_at_inclusive(self):
+        """Balance at t includes transaction with when == t."""
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=10)
+        balance = self.ledger.balance("cash", at=10)
+        self.assertEqual(balance, Decimal("5.00"))
+    
+    def test_balance_before_first_transaction_zero(self):
+        """Balance before any transaction is zero."""
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=10)
+        balance = self.ledger.balance("cash", at=5)
+        self.assertEqual(balance, Decimal("0.00"))
+    
+    def test_balance_at_none_includes_all(self):
+        """Balance at None includes all transactions."""
