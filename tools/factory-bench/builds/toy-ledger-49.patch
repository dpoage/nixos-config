+class TestKeys(unittest.TestCase):
+    """Property 7: Keys. 
+    Call with key that accepted transaction used + same request -> returns that id, no change.
+    Same key + different request -> raises ValueError.
+    post and reverse share key space. Raising call doesn't claim key.
+    Mutant: compare entries as ordered list (not multiset).
+    """
+    
+    def setUp(self):
+        self.ledger = Ledger({"USD": 2})
+        self.ledger.open("cash", "USD")
+        self.ledger.open("checking", "USD")
+    
+    def test_duplicate_key_same_request_returns_id(self):
+        """Duplicate key with same request returns original txn_id."""
+        txn_id1 = self.ledger.post(
+            [("cash", "5"), ("checking", "-5")],
+            when=10,
+            key="k1"
+        )
+        txn_id2 = self.ledger.post(
+            [("cash", "5"), ("checking", "-5")],
+            when=10,
+            key="k1"
+        )
+        self.assertEqual(txn_id1, txn_id2)
+    
+    def test_duplicate_key_different_request_raises(self):
+        """Duplicate key with different request raises ValueError."""
+        self.ledger.post(
+            [("cash", "5"), ("checking", "-5")],
+            when=10,
+            key="k1"
+        )
+        with self.assertRaises(ValueError):
+            self.ledger.post(
+                [("cash", "10"), ("checking", "-10")],
+                when=10,
+                key="k1"
+            )
+    
+    def test_failed_post_does_not_claim_key(self):
+        """Failed post does not claim its key."""
+        with self.assertRaises(ValueError):
+            self.ledger.post(
+                [("cash", "5"), ("checking", "-3")],  # unbalanced
+                when=10,
+                key="k1"
+            )
+        # Key should still be available
+        txn_id = self.ledger.post(
+            [("cash", "5"), ("checking", "-5")],
+            when=10,
+            key="k1"
+        )
+        self.assertEqual(txn_id, 1)
+    
+    def test_key_order_independent(self):
+        """Key matching is independent of entry order."""
+        txn_id1 = self.ledger.post(
+            [("cash", "5"), ("checking", "-5")],
+            when=10,
+            key="k1"
+        )
+        txn_id2 = self.ledger.post(
+            [("checking", "-5"), ("cash", "5")],
+            when=10,
+            key="k1"
+        )
+        self.assertEqual(txn_id1, txn_id2)
+    
+    def test_key_amount_normalization(self):
+        """Key matching normalizes amount representations."""
+        txn_id1 = self.ledger.post(
+            [("cash", "5.00"), ("checking", "-5.00")],
+            when=10,
+            key="k1"
+        )
+        txn_id2 = self.ledger.post(
+            [("cash", "5"), ("checking", "-5")],
+            when=10,
+            key="k1"
+        )
+        self.assertEqual(txn_id1, txn_id2)
+    
+    def test_key_post_and_reverse_share_space(self):
+        """post and reverse share key space."""
+        txn_id = self.ledger.post(
+            [("cash", "5"), ("checking", "-5")],
+            when=10,
+            key="k1"
+        )
+        # Try to reverse with same key - should fail (different request)
+        with self.assertRaises(ValueError):
+            self.ledger.reverse(txn_id, when=20, key="k1")
+
