+        self.ledger.open("cash", "USD")
+        self.ledger.open("expense", "USD")
+
+    def test_statement_basic(self):
+        """Statement returns lines in time and id order."""
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=10)
+        self.ledger.post([("cash", "3"), ("expense", "-3")], when=20)
+        
+        stmt = self.ledger.statement("cash", 0, 100)
+        self.assertEqual(len(stmt), 2)
+        self.assertEqual(stmt[0][0], 10)  # when
+        self.assertEqual(stmt[0][1], 1)   # txn_id
+        self.assertEqual(stmt[0][2], Decimal("5.00"))  # amount
+        self.assertEqual(stmt[0][3], Decimal("5.00"))  # running
+        self.assertEqual(stmt[1][3], Decimal("8.00"))  # running
+
+    def test_statement_start_inclusive_end_exclusive(self):
+        """Statement uses start <= when < end."""
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=10)
+        self.ledger.post([("cash", "3"), ("expense", "-3")], when=20)
+        self.ledger.post([("cash", "2"), ("expense", "-2")], when=30)
+        
+        stmt = self.ledger.statement("cash", 10, 30)
+        self.assertEqual(len(stmt), 2)
+        self.assertEqual([s[0] for s in stmt], [10, 20])
+
+    def test_statement_running_balance(self):
+        """Running balance includes all earlier lines."""
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=10)
+        self.ledger.post([("cash", "3"), ("expense", "-3")], when=5)
+        self.ledger.post([("cash", "2"), ("expense", "-2")], when=20)
+        
+        stmt = self.ledger.statement("cash", 0, 100)
+        # Lines should be in time order: 5, 10, 20
+        # Running: 3, 8, 10
+        self.assertEqual(stmt[0][3], Decimal("3.00"))  # at time 5
+        self.assertEqual(stmt[1][3], Decimal("8.00"))  # at time 10
+        self.assertEqual(stmt[2][3], Decimal("10.00"))  # at time 20
+
+    def test_statement_start_greater_than_end_raises(self):
+        """start > end raises ValueError."""
+        with self.assertRaises(ValueError):
+            self.ledger.statement("cash", 100, 50)
+
+    def test_statement_unknown_account_raises(self):
+        """Unknown account raises KeyError."""
+        with self.assertRaises(KeyError):
+            self.ledger.statement("unknown", 0, 100)
