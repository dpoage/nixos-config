+    """A double-entry ledger supporting multiple currencies."""
+
+    def __init__(self, currencies: dict[str, int]) -> None:
+        """Initialize ledger with currency exponents.
+        
+        Args:
+            currencies: dict mapping currency codes to decimal exponents.
+        
+        Raises:
+            ValueError: if any exponent is negative.
+        """
+        for code, exponent in currencies.items():
+            if exponent < 0:
+                raise ValueError(f"Exponent for {code} is negative")
+        
+        self._currencies = currencies
+        self._accounts = {}  # account_name -> currency
+        self._closed = set()  # closed account names
+        self._transactions = []  # list of (when, entries) tuples
+        self._keys = {}  # key -> (txn_id, request)
+        self._reversals = {}  # txn_id -> reversed_by_txn_id or None if already reversed
+
+    def open(self, account: str, currency: str) -> None:
+        """Open an account in a currency.
+        
+        Args:
+            account: account name.
+            currency: currency code.
+        
+        Raises:
+            KeyError: if currency not in ledger.
+            ValueError: if account already exists.
+        """
+        if currency not in self._currencies:
+            raise KeyError(f"Unknown currency: {currency}")
+        if account in self._accounts:
+            raise ValueError(f"Account already exists: {account}")
+        
+        self._accounts[account] = currency
+
+    def post(self, entries: Iterable, *, when: int, key: Optional[str] = None) -> int:
+        """Post a transaction.
+        
+        Args:
+            entries: iterable of (account, amount_str) pairs.
+            when: transaction timestamp.
+            key: optional idempotency key.
+        
+        Returns:
+            transaction id (1-based).
+        
+        Raises:
+            KeyError: if unknown account or key mismatch.
+            ValueError: if invalid amount, closed account, or entries don't balance.
+        """
+        # Convert entries to list to validate and potentially reuse
+        entries_list = list(entries)
+        
+        # Check minimum entries
+        if len(entries_list) < 2:
+            raise ValueError("Transaction must have at least 2 entries")
+        
+        # Validate and parse amounts, track by currency
+        parsed_entries = []
+        by_currency = {}
+        
+        for account, amount_str in entries_list:
+            # Check if account exists
+            if account not in self._accounts:
+                raise KeyError(f"Unknown account: {account}")
+            
+            # Check if account is closed
+            if account in self._closed:
+                raise ValueError(f"Account is closed: {account}")
+            
+            # Validate and parse amount
+            amount_decimal = self._parse_amount(amount_str, account)
+            
+            currency = self._accounts[account]
+            if currency not in by_currency:
+                by_currency[currency] = Decimal(0)
+            by_currency[currency] += amount_decimal
+            
+            parsed_entries.append((account, amount_decimal))
+        
+        # Check that each currency balances
+        for currency, total in by_currency.items():
+            if total != 0:
+                raise ValueError(f"Entries for {currency} do not sum to zero")
+        
+        # Build request for key deduplication
+        request = self._make_request("post", when, entries_list)
+        
+        # Check key
+        if key is not None:
+            if key in self._keys:
+                prev_txn_id, prev_request = self._keys[key]
+                if prev_request != request:
+                    raise ValueError(f"Key already used with different request")
+                return prev_txn_id
+        
+        # Accept transaction
+        txn_id = len(self._transactions) + 1
+        self._transactions.append((when, parsed_entries))
+        self._reversals[txn_id] = None
+        
+        if key is not None:
+            self._keys[key] = (txn_id, request)
+        
+        return txn_id
+
+    def reverse(self, txn_id: int, *, when: int, key: Optional[str] = None) -> int:
+        """Reverse a transaction.
+        
+        Args:
+            txn_id: id of transaction to reverse.
+            when: timestamp for reversal transaction.
+            key: optional idempotency key.
+        
+        Returns:
+            id of reversal transaction.
+        
+        Raises:
+            KeyError: if txn_id unknown or key mismatch.
+            ValueError: if already reversed or other conditions.
+        """
+        if txn_id < 1 or txn_id > len(self._transactions):
+            raise KeyError(f"Unknown transaction: {txn_id}")
+        
+        # Get original transaction (needed to build request for key check)
+        original_when, original_entries = self._transactions[txn_id - 1]
+        
+        # Build request for key (do this before other checks)
+        request = self._make_request("reverse", when, txn_id)
+        
+        # Check key FIRST - this allows idempotent repeated calls
+        if key is not None:
+            if key in self._keys:
+                prev_txn_id, prev_request = self._keys[key]
+                if prev_request != request:
+                    raise ValueError(f"Key already used with different request")
+                return prev_txn_id
+        
+        # Check if already reversed
+        if self._reversals[txn_id] is not None:
+            raise ValueError(f"Transaction already reversed: {txn_id}")
+        
+        # Check if original is itself a reversal
+        for other_id, reversed_by in self._reversals.items():
+            if reversed_by == txn_id:
+                raise ValueError(f"Cannot reverse a reversal")
+        
+        # Check timestamp
+        if when < original_when:
+            raise ValueError(f"Reversal timestamp before original")
+        
+        # Build reversed entries
+        reversed_entries = []
+        for account, amount in original_entries:
+            if account in self._closed:
+                raise ValueError(f"Account is closed: {account}")
+            reversed_entries.append((account, -amount))
+        
+        # Accept reversal - create new post with negated entries
+        entry_tuples = [(account, str(amount)) for account, amount in reversed_entries]
+        reversal_txn_id = self.post(entry_tuples, when=when, key=None)
+        
+        # Mark original as reversed
+        self._reversals[txn_id] = reversal_txn_id
+        
+        if key is not None:
+            self._keys[key] = (reversal_txn_id, request)
+        
+        return reversal_txn_id
+
+
+    def balance(self, account: str, *, at: Optional[int] = None) -> Decimal:
+        """Get account balance at a point in time.
+        
+        Args:
+            account: account name.
+            at: optional timestamp (None means all transactions).
+        
+        Returns:
+            balance as Decimal with currency exponent precision.
+        
+        Raises:
+            KeyError: if account unknown.
+        """
+        if account not in self._accounts:
+            raise KeyError(f"Unknown account: {account}")
+        
+        currency = self._accounts[account]
+        exponent = self._currencies[currency]
+        
+        total = Decimal(0)
+        for when, entries in self._transactions:
+            if at is not None and when > at:
+                continue
+            for entry_account, amount in entries:
+                if entry_account == account:
+                    total += amount
+        
+        # Format with proper exponent
+        return self._format_decimal(total, exponent)
+
+    def balances(self, *, at: Optional[int] = None) -> dict[str, Decimal]:
+        """Get all non-zero balances at a point in time.
+        
+        Args:
+            at: optional timestamp (None means all transactions).
+        
+        Returns:
+            dict mapping account names to balances, ordered by name.
+        """
+        result = {}
+        for account in sorted(self._accounts.keys()):
+            balance = self.balance(account, at=at)
+            if balance != 0:
+                result[account] = balance
+        return result
+
+    def statement(self, account: str, start: int, end: int) -> list[tuple]:
+        """Get account statement within time range.
+        
+        Args:
+            account: account name.
+            start: start timestamp (inclusive).
+            end: end timestamp (exclusive).
+        
+        Returns:
+            list of (when, txn_id, amount, running) tuples.
+        
+        Raises:
+            KeyError: if account unknown.
+            ValueError: if start > end.
+        """
+        if account not in self._accounts:
+            raise KeyError(f"Unknown account: {account}")
+        
+        if start > end:
+            raise ValueError("start > end")
+        
+        currency = self._accounts[account]
+        exponent = self._currencies[currency]
+        
+        # Build list of (when, txn_id, entries) tuples and sort by (when, txn_id)
+        sorted_transactions = []
+        for txn_id, (when, entries) in enumerate(self._transactions, 1):
+            sorted_transactions.append((when, txn_id, entries))
+        
+        sorted_transactions.sort(key=lambda x: (x[0], x[1]))
+        
+        result = []
+        running = Decimal(0)
+        
+        for when, txn_id, entries in sorted_transactions:
+            # Update running balance for all prior transactions
+            if when < start:
+                for entry_account, amount in entries:
+                    if entry_account == account:
+                        running += amount
+                continue
+            
+            # Process transactions in statement range
+            if when < end:
+                for entry_account, amount in entries:
+                    if entry_account == account:
+                        running += amount
+                        # Add entry to result
+                        result.append((
+                            when,
+                            txn_id,
+                            self._format_decimal(amount, exponent),
+                            self._format_decimal(running, exponent)
+                        ))
+        
+        return result
+
+    def close(self, account: str) -> None:
+        """Close an account.
+        
+        Args:
+            account: account name.
+        
+        Raises:
+            KeyError: if account unknown.
+            ValueError: if already closed or balance not zero.
+        """
+        if account not in self._accounts:
+            raise KeyError(f"Unknown account: {account}")
+        
+        if account in self._closed:
+            raise ValueError(f"Account already closed: {account}")
+        
+        balance = self.balance(account)
+        if balance != 0:
+            raise ValueError(f"Cannot close account with non-zero balance")
+        
+        self._closed.add(account)
+
+    def _parse_amount(self, amount_str, account: str) -> Decimal:
+        """Parse and validate an amount string.
+        
+        Raises:
+            ValueError: if amount is invalid.
+        """
+        # Must be a string
+        if not isinstance(amount_str, str):
+            raise ValueError(f"Amount must be a string: {amount_str}")
+        
+        # Check format: -?\d+(\.\d+)?
+        import re
+        if not re.match(r'^-?\d+(\.\d+)?$', amount_str):
+            raise ValueError(f"Invalid amount format: {amount_str}")
+        
+        decimal_value = Decimal(amount_str)
+        
+        # Must not be zero
+        if decimal_value == 0:
+            raise ValueError(f"Amount cannot be zero")
+        
+        # Check exponent matches currency
+        currency = self._accounts[account]
+        exponent = self._currencies[currency]
+        
+        # Count decimal places
+        if '.' in amount_str:
+            decimal_places = len(amount_str.split('.')[1])
+        else:
+            decimal_places = 0
+        
+        if decimal_places > exponent:
+            raise ValueError(
+                f"Amount {amount_str} has too many decimal places for {currency}"
+            )
+        
+        return decimal_value
+
+    def _format_decimal(self, value: Decimal, exponent: int) -> Decimal:
+        """Format a decimal to the proper exponent precision."""
+        if exponent == 0:
+            return Decimal(int(value))
+        quantize_str = '0.' + '0' * exponent
+        return value.quantize(Decimal(quantize_str))
+
+    def _make_request(self, op: str, when: int, data):
+        """Create a hashable request tuple for key deduplication."""
+        if op == "post":
+            # entries_list -> multiset of (account, numeric value)
+            entries_list = data
+            multiset = tuple(sorted(
+                (account, str(Decimal(amount_str)))
+                for account, amount_str in entries_list
+            ))
+            return ("post", when, multiset)
+        elif op == "reverse":
+            # txn_id
+            txn_id = data
+            return ("reverse", when, txn_id)
+        else:
+            raise ValueError(f"Unknown operation: {op}")
