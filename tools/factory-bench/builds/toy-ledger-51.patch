@@ -0,0 +1,503 @@
+import unittest
+from decimal import Decimal
+from ledger import Ledger
+
+
+class SetupTests(unittest.TestCase):
+    """Test Property 1: Setup."""
+
+    def test_negative_exponent_raises(self):
+        """Negative exponent should raise ValueError."""
+        with self.assertRaises(ValueError):
+            Ledger({"USD": -1})
+
+    def test_open_unknown_currency_raises(self):
+        """Opening account with unknown currency raises KeyError."""
+        ledger = Ledger({"USD": 2})
+        with self.assertRaises(KeyError):
+            ledger.open("checking", "EUR")
+
+    def test_open_duplicate_account_raises(self):
+        """Opening same account twice raises ValueError."""
+        ledger = Ledger({"USD": 2})
+        ledger.open("checking", "USD")
+        with self.assertRaises(ValueError):
+            ledger.open("checking", "USD")
+
+    def test_open_success(self):
+        """Successfully opening account does not raise."""
+        ledger = Ledger({"USD": 2})
+        ledger.open("checking", "USD")
+
+
+class PostingAtomicityTests(unittest.TestCase):
+    """Test Property 2: Posting is atomic."""
+
+    def setUp(self):
+        self.ledger = Ledger({"USD": 2})
+        self.ledger.open("cash", "USD")
+        self.ledger.open("expense", "USD")
+
+    def test_unknown_account_raises_keyerror(self):
+        """Unknown account raises KeyError."""
+        with self.assertRaises(KeyError):
+            self.ledger.post([("cash", "5"), ("unknown", "-5")], when=0)
+        # Verify nothing was posted
+        self.assertEqual(self.ledger.balance("cash"), Decimal("0.00"))
+
+    def test_invalid_amount_raises_valueerror(self):
+        """Invalid amount raises ValueError."""
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "5.000"), ("expense", "-5.000")], when=0)
+        self.assertEqual(self.ledger.balance("cash"), Decimal("0.00"))
+
+    def test_fewer_than_two_entries_raises(self):
+        """Fewer than 2 entries raises ValueError."""
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "5")], when=0)
+        self.assertEqual(self.ledger.balance("cash"), Decimal("0.00"))
+
+    def test_closed_account_raises(self):
+        """Posting to closed account raises ValueError."""
+        txn_id = self.ledger.post([("cash", "5"), ("expense", "-5")], when=0)
+        self.ledger.reverse(txn_id, when=1)  # Reverse to make balance 0
+        self.ledger.close("cash")
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "10"), ("expense", "-10")], when=2)
+        self.assertEqual(self.ledger.balance("cash"), Decimal("0.00"))
+
+    def test_entries_dont_balance_raises(self):
+        """Entries that don't sum to zero raise ValueError."""
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "5"), ("expense", "-3")], when=0)
+        self.assertEqual(self.ledger.balance("cash"), Decimal("0.00"))
+
+    def test_unknown_account_before_other_errors(self):
+        """KeyError for unknown account raised before other errors."""
+        with self.assertRaises(KeyError):
+            self.ledger.post([("cash", "5"), ("unknown", "-3")], when=0)
+
+    def test_post_success_two_entries(self):
+        """Successfully posting 2 entries."""
+        txn_id = self.ledger.post([("cash", "5"), ("expense", "-5")], when=0)
+        self.assertEqual(txn_id, 1)
+        self.assertEqual(self.ledger.balance("cash"), Decimal("5.00"))
+
+    def test_post_success_multiple_entries(self):
+        """Successfully posting 3+ entries."""
+        ledger = Ledger({"USD": 2})
+        ledger.open("cash", "USD")
+        ledger.open("savings", "USD")
+        ledger.open("expense", "USD")
+        txn_id = ledger.post(
+            [("cash", "10"), ("savings", "-5"), ("expense", "-5")], when=0
+        )
+        self.assertEqual(txn_id, 1)
+
+
+class AmountPrecisionTests(unittest.TestCase):
+    """Test Property 3: Amounts keep their exponent."""
+
+    def test_usd_new_account_precision(self):
+        """New USD account has 2 decimal places."""
+        ledger = Ledger({"USD": 2})
+        ledger.open("cash", "USD")
+        balance = ledger.balance("cash")
+        self.assertEqual(balance, Decimal("0.00"))
+        self.assertEqual(str(balance), "0.00")
+
+    def test_jpy_new_account_precision(self):
+        """New JPY account has 0 decimal places."""
+        ledger = Ledger({"JPY": 0})
+        ledger.open("cash", "JPY")
+        balance = ledger.balance("cash")
+        self.assertEqual(balance, Decimal("0"))
+        self.assertEqual(str(balance), "0")
+
+    def test_balance_precision_multiple_currencies(self):
+        """Balance respects currency precision."""
+        ledger = Ledger({"USD": 2, "JPY": 0})
+        ledger.open("cash_usd", "USD")
+        ledger.open("cash_jpy", "JPY")
+        ledger.open("expense", "USD")
+        ledger.open("expense_jpy", "JPY")
+        
+        ledger.post([("cash_usd", "5"), ("expense", "-5")], when=0)
+        ledger.post([("cash_jpy", "100"), ("expense_jpy", "-100")], when=0)
+        
+        self.assertEqual(str(ledger.balance("cash_usd")), "5.00")
+        self.assertEqual(str(ledger.balance("cash_jpy")), "100")
+
+
+class DatedBalanceTests(unittest.TestCase):
+    """Test Property 4: Dated balance."""
+
+    def setUp(self):
+        self.ledger = Ledger({"USD": 2})
+        self.ledger.open("cash", "USD")
+        self.ledger.open("expense", "USD")
+
+    def test_balance_at_specific_time(self):
+        """Balance at specific time includes transactions up to that time."""
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=10)
+        self.ledger.post([("cash", "3"), ("expense", "-3")], when=20)
+        
+        self.assertEqual(self.ledger.balance("cash", at=5), Decimal("0.00"))
+        self.assertEqual(self.ledger.balance("cash", at=10), Decimal("5.00"))
+        self.assertEqual(self.ledger.balance("cash", at=15), Decimal("5.00"))
+        self.assertEqual(self.ledger.balance("cash", at=20), Decimal("8.00"))
+
+    def test_balance_none_means_all_transactions(self):
+        """at=None includes all transactions."""
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=10)
+        self.ledger.post([("cash", "3"), ("expense", "-3")], when=20)
+        
+        self.assertEqual(self.ledger.balance("cash", at=None), Decimal("8.00"))
+
+    def test_transactions_out_of_order(self):
+        """Transactions can be accepted out of order."""
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=20)
+        self.ledger.post([("cash", "3"), ("expense", "-3")], when=10)
+        
+        self.assertEqual(self.ledger.balance("cash", at=5), Decimal("0.00"))
+        self.assertEqual(self.ledger.balance("cash", at=10), Decimal("3.00"))
+        self.assertEqual(self.ledger.balance("cash", at=20), Decimal("8.00"))
+
+
+class BalancesTests(unittest.TestCase):
+    """Test Property 5: Balances."""
+
+    def test_balances_non_zero_only(self):
+        """balances() includes only non-zero balances."""
+        ledger = Ledger({"USD": 2})
+        ledger.open("cash", "USD")
+        ledger.open("savings", "USD")
+        ledger.open("expense", "USD")
+        
+        # Post to cash only
+        ledger.post([("cash", "5"), ("expense", "-5")], when=0)
+        
+        balances = ledger.balances()
+        self.assertIn("cash", balances)
+        self.assertNotIn("savings", balances)
+        self.assertIn("expense", balances)  # expense has -5, which is non-zero
+
+    def test_balances_ordered_by_name(self):
+        """balances() returns accounts in alphabetical order."""
