+import unittest
+from decimal import Decimal
+from ledger import Ledger
+
+
+class SetupTest(unittest.TestCase):
+    """Property 1: Setup validation."""
+
+    def test_negative_exponent_raises(self):
+        with self.assertRaises(ValueError):
+            Ledger({"USD": -1})
+
+    def test_open_unknown_currency_raises(self):
+        ledger = Ledger({"USD": 2})
+        with self.assertRaises(KeyError):
+            ledger.open("cash", "EUR")
+
+    def test_open_duplicate_raises(self):
+        ledger = Ledger({"USD": 2})
+        ledger.open("cash", "USD")
+        with self.assertRaises(ValueError):
+            ledger.open("cash", "USD")
+
+    def test_zero_exponent_valid(self):
+        ledger = Ledger({"JPY": 0})
+        ledger.open("cash", "JPY")
+
+
+class PostingAtomicityTest(unittest.TestCase):
+    """Property 2: Posting is atomic."""
+
+    def setUp(self):
+        self.ledger = Ledger({"USD": 2})
+        self.ledger.open("cash", "USD")
+        self.ledger.open("expense", "USD")
+
+    def test_unknown_account_raises(self):
+        with self.assertRaises(KeyError):
+            self.ledger.post([("unknown", "5"), ("cash", "-5")], when=1)
+
+    def test_invalid_amount_raises(self):
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "5.000"), ("expense", "-5")], when=1)
+
+    def test_non_string_amount_raises(self):
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", 5), ("expense", -5)], when=1)
+
+    def test_too_few_entries_raises(self):
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "5")], when=1)
+
+    def test_closed_account_raises(self):
+        self.ledger.post([("cash", "10"), ("expense", "-10")], when=1)
+        self.ledger.post([("cash", "-10"), ("expense", "10")], when=2)
+        self.ledger.close("cash")
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "5"), ("expense", "-5")], when=3)
+
+    def test_entries_dont_balance_raises(self):
+        with self.assertRaises(ValueError):
+            self.ledger.post([("cash", "5"), ("expense", "-3")], when=1)
+
+    def test_known_and_unknown_account_raises_keyerror(self):
+        with self.assertRaises(KeyError):
+            self.ledger.post([("cash", "5"), ("unknown", "-5")], when=1)
+
+    def test_per_currency_balance_required(self):
+        ledger = Ledger({"USD": 2, "EUR": 2})
+        ledger.open("cash_usd", "USD")
+        ledger.open("cash_eur", "EUR")
+        ledger.open("expense", "USD")
+        with self.assertRaises(ValueError):
+            ledger.post([
+                ("cash_usd", "5"),
+                ("cash_eur", "5"),
+                ("expense", "-5"),
+            ], when=1)
+
+    def test_atomicity_on_error(self):
+        self.ledger.post([("cash", "10"), ("expense", "-10")], when=1)
+        bal_before = self.ledger.balance("cash")
+        try:
+            self.ledger.post([("cash", "5"), ("expense", "-3")], when=2)
+        except ValueError:
+            pass
+        self.assertEqual(self.ledger.balance("cash"), bal_before)
+
+
+class AmountExponentTest(unittest.TestCase):
+    """Property 3: Amounts keep their exponent."""
+
+    def test_usd_decimal_places(self):
+        ledger = Ledger({"USD": 2})
+        ledger.open("cash", "USD")
+        self.assertEqual(str(ledger.balance("cash")), "0.00")
+
+    def test_jpy_decimal_places(self):
+        ledger = Ledger({"JPY": 0})
+        ledger.open("cash", "JPY")
+        self.assertEqual(str(ledger.balance("cash")), "0")
+
+    def test_balance_preserves_exponent_after_post(self):
+        ledger = Ledger({"USD": 2})
+        ledger.open("cash", "USD")
+        ledger.open("expense", "USD")
+        ledger.post([("cash", "5.00"), ("expense", "-5.00")], when=1)
+        self.assertEqual(str(ledger.balance("expense")), "5.00")
+
+
+class DatedBalanceTest(unittest.TestCase):
+    """Property 4: Dated balance."""
+
+    def setUp(self):
+        self.ledger = Ledger({"USD": 2})
+        self.ledger.open("cash", "USD")
+        self.ledger.open("expense", "USD")
+
+    def test_at_none_means_all_time(self):
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=1)
+        self.ledger.post([("cash", "10"), ("expense", "-10")], when=2)
+        self.assertEqual(self.ledger.balance("cash", at=None), Decimal("-15.00"))
+
+    def test_at_includes_equal_timestamp(self):
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=1)
+        self.ledger.post([("cash", "10"), ("expense", "-10")], when=2)
+        self.assertEqual(self.ledger.balance("cash", at=1), Decimal("-5.00"))
+
+    def test_at_excludes_later(self):
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=1)
+        self.ledger.post([("cash", "10"), ("expense", "-10")], when=2)
+        self.assertEqual(self.ledger.balance("cash", at=1), Decimal("-5.00"))
+
+    def test_transactions_accepted_out_of_order(self):
+        self.ledger.post([("cash", "10"), ("expense", "-10")], when=2)
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=1)
+        self.assertEqual(self.ledger.balance("cash", at=1), Decimal("-5.00"))
+
+
+class BalancesTest(unittest.TestCase):
+    """Property 5: Balances."""
+
+    def test_nonzero_balances_only(self):
+        ledger = Ledger({"USD": 2})
+        ledger.open("cash", "USD")
+        ledger.open("savings", "USD")
+        ledger.open("expense", "USD")
+        ledger.post([("cash", "10"), ("expense", "-10")], when=1)
+        balances = ledger.balances()
+        self.assertNotIn("savings", balances)
+        self.assertEqual(len(balances), 2)
+
+    def test_ordered_by_name(self):
+        ledger = Ledger({"USD": 2})
+        ledger.open("zebra", "USD")
+        ledger.open("apple", "USD")
+        ledger.open("expense", "USD")
+        ledger.post([("zebra", "5"), ("expense", "-5")], when=1)
+        ledger.post([("apple", "10"), ("expense", "-10")], when=2)
+        balances = ledger.balances()
+        keys = list(balances.keys())
+        self.assertEqual(keys, ["apple", "expense", "zebra"])
+
+    def test_at_parameter(self):
+        ledger = Ledger({"USD": 2})
+        ledger.open("cash", "USD")
+        ledger.open("expense", "USD")
+        ledger.post([("cash", "10"), ("expense", "-10")], when=2)
+        ledger.post([("cash", "5"), ("expense", "-5")], when=4)
+        balances = ledger.balances(at=2)
+        self.assertEqual(balances["cash"], Decimal("-10.00"))
+
+
+class StatementTest(unittest.TestCase):
+    """Property 6: Statement."""
+
+    def setUp(self):
+        self.ledger = Ledger({"USD": 2})
+        self.ledger.open("cash", "USD")
+        self.ledger.open("expense", "USD")
+
+    def test_start_end_inclusive_exclusive(self):
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=1)
+        self.ledger.post([("cash", "10"), ("expense", "-10")], when=2)
+        self.ledger.post([("cash", "7"), ("expense", "-7")], when=3)
+        stmt = self.ledger.statement("cash", 2, 3)
+        self.assertEqual(len(stmt), 1)
+        self.assertEqual(stmt[0][0], 2)
+
+    def test_statement_format(self):
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=1)
+        stmt = self.ledger.statement("cash", 1, 2)
+        self.assertEqual(len(stmt), 1)
+        when, txn_id, amount, running = stmt[0]
+        self.assertEqual(when, 1)
+        self.assertEqual(txn_id, 1)
+        self.assertEqual(amount, Decimal("-5.00"))
+        self.assertEqual(running, Decimal("-5.00"))
+
+    def test_running_balance_includes_before_start(self):
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=1)
+        self.ledger.post([("cash", "10"), ("expense", "-10")], when=3)
+        stmt = self.ledger.statement("cash", 2, 4)
+        self.assertEqual(len(stmt), 1)
+        self.assertEqual(stmt[0][3], Decimal("-15.00"))
+
+    def test_ordered_by_when_and_id(self):
+        self.ledger.post([("cash", "5"), ("expense", "-5")], when=1)
+        self.ledger.post([("cash", "10"), ("expense", "-10")], when=1)
+        stmt = self.ledger.statement("cash", 1, 2)
+        self.assertEqual(len(stmt), 2)
+        self.assertEqual(stmt[0][1], 1)
+        self.assertEqual(stmt[1][1], 2)
+
+    def test_start_greater_than_end_raises(self):
+        with self.assertRaises(ValueError):
+            self.ledger.statement("cash", 5, 2)
+
+    def test_unknown_account_raises(self):
+        with self.assertRaises(KeyError):
+            self.ledger.statement("unknown", 1, 2)
+
+
+class KeysTest(unittest.TestCase):
+    """Property 7: Keys."""
+
+    def setUp(self):
+        self.ledger = Ledger({"USD": 2})
+        self.ledger.open("cash", "USD")
+        self.ledger.open("expense", "USD")
+        self.ledger.open("equity", "USD")
+
+    def test_idempotent_post_same_key(self):
+        txn1 = self.ledger.post(
+            [("cash", "5"), ("expense", "-5")],
+            when=1,
+            key="k1"
+        )
+        txn2 = self.ledger.post(
+            [("cash", "5"), ("expense", "-5")],
+            when=1,
+            key="k1"
+        )
+        self.assertEqual(txn1, txn2)
+        self.assertEqual(len(self.ledger.transactions), 1)
+
+    def test_different_request_same_key_raises(self):
+        self.ledger.post(
+            [("cash", "5"), ("expense", "-5")],
+            when=1,
+            key="k1"
+        )
+        with self.assertRaises(ValueError):
+            self.ledger.post(
+                [("cash", "10"), ("expense", "-10")],
+                when=1,
+                key="k1"
+            )
+
+    def test_key_survives_account_close(self):
+        txn1 = self.ledger.post(
+            [("cash", "10"), ("expense", "-10")],
