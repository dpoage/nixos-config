@@ -3,3 +3,82 @@
 A double-entry ledger that holds several currencies.
 
 Run the suite: `python3 -m unittest discover -s tests -t .`
+
+## Usage
+
+Create a ledger with currencies and their decimal exponents:
+
+```python
+from ledger import Ledger
+
+# Create a ledger supporting USD (2 decimal places) and JPY (0 decimal places)
+ledger = Ledger({"USD": 2, "JPY": 0})
+```
+
+Open accounts for each currency:
+
+```python
+ledger.open("cash", "USD")
+ledger.open("checking", "USD")
+ledger.open("yen_account", "JPY")
+```
+
+Post transactions. Each transaction must balance per currency:
+
+```python
+# Transfer $5 from cash to checking
+txn_id = ledger.post([("cash", "-5"), ("checking", "5")], when=1)
+```
+
+Query account balances:
+
+```python
+# Get current balance of an account
+balance = ledger.balance("cash")  # Returns Decimal("-5.00")
+
+# Get balance at a specific time
+balance_then = ledger.balance("cash", at=1)
+
+# Get all non-zero balances
+all_balances = ledger.balances()
+```
+
+View transaction statements:
+
+```python
+# Get account statement for a time range
+statement = ledger.statement("cash", start=0, end=100)
+# Each item is (when, txn_id, amount, running_balance)
+```
+
+Reverse transactions:
+
+```python
+# Reverse a previous transaction
+reversal_id = ledger.reverse(txn_id, when=2)
+```
+
+Close accounts:
+
+```python
+# Close an account with zero balance
+ledger.close("cash")
+```
+
+Idempotent transactions:
+
+```python
+# Use keys to make transactions idempotent
+txn_id = ledger.post(
+    [("cash", "-5"), ("checking", "5")],
+    when=1,
+    key="transfer_001"
+)
+# Posting with the same key and request returns the same transaction ID
+txn_id2 = ledger.post(
+    [("cash", "-5"), ("checking", "5")],
+    when=1,
+    key="transfer_001"
+)
+assert txn_id == txn_id2
+```
