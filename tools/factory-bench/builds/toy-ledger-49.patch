+class TestReversal(unittest.TestCase):
+    """Property 8: Reversal. 
+    reverse(txn_id, when=t) accepts new transaction with negated lines.
+    Raises when: id unknown (KeyError); original is reversal; already reversed;
+    t < original's when; account closed (ValueError).
+    Mutant: allow second reversal.
+    """
+    
+    def setUp(self):
+        self.ledger = Ledger({"USD": 2})
+        self.ledger.open("cash", "USD")
+        self.ledger.open("checking", "USD")
+    
+    def test_reverse_unknown_txn_raises_keyerror(self):
+        """Reversing unknown transaction raises KeyError."""
+        with self.assertRaises(KeyError):
+            self.ledger.reverse(999, when=10)
+    
+    def test_reverse_negates_amounts(self):
+        """Reversal creates transaction with negated amounts."""
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=10)
+        rev_id = self.ledger.reverse(1, when=20)
+        
+        # Check reversal transaction
+        statement = self.ledger.statement("cash", 0, 100)
+        # Should have 2 lines: original and reversal
+        self.assertEqual(len(statement), 2)
+        self.assertEqual(statement[1][2], Decimal("-5.00"))  # negated
+    
+    def test_reverse_reversal_raises(self):
+        """Cannot reverse a reversal."""
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=10)
+        rev_id = self.ledger.reverse(1, when=20)
+        
+        with self.assertRaises(ValueError):
+            self.ledger.reverse(rev_id, when=30)
+    
+    def test_reverse_twice_raises(self):
+        """Cannot reverse same transaction twice."""
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=10)
+        self.ledger.reverse(1, when=20)
+        
+        with self.assertRaises(ValueError):
+            self.ledger.reverse(1, when=30)
+    
+    def test_reverse_before_original_raises(self):
+        """Reversing before original's when raises ValueError."""
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=10)
+        
+        with self.assertRaises(ValueError):
+            self.ledger.reverse(1, when=5)
+    
+    def test_reverse_at_same_time_allowed(self):
+        """Reversing at original's when is allowed."""
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=10)
+        rev_id = self.ledger.reverse(1, when=10)
+        self.assertEqual(rev_id, 2)
+    
+    def test_reverse_on_closed_account_raises(self):
+        """Reversing transaction with closed account raises ValueError."""
+        # Post transaction 1
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=10)
+        # Post transaction 2 to balance cash
+        self.ledger.post([("cash", "-5"), ("checking", "5")], when=15)
+        # Now cash has zero balance, can close it
+        self.ledger.close("cash")
+        
+        # Try to reverse transaction 1 - should fail because cash is closed
+        with self.assertRaises(ValueError):
+            self.ledger.reverse(1, when=20)
+    
+    def test_reverse_returns_new_txn_id(self):
+        """Reverse returns ID of new reversal transaction."""
+        self.ledger.post([("cash", "5"), ("checking", "-5")], when=10)
+        rev_id = self.ledger.reverse(1, when=20)
+        self.assertEqual(rev_id, 2)
+
