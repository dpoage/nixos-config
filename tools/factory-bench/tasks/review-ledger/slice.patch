+class TestStatement(unittest.TestCase):
+    """Property 6: statement rows, ordering, bounds, and running balance."""
+
+    def test_running_includes_lines_before_start(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "10"), ("bank", "-10")], when=1)
+        ledger.post([("cash", "3"), ("bank", "-3")], when=5)
+        ledger.post([("cash", "-4"), ("bank", "4")], when=9)
+        self.assertEqual(
+            ledger.statement("cash", 5, 9),
+            [(5, 2, Decimal("3.00"), Decimal("13.00"))],
+        )
+        self.assertEqual(
+            ledger.statement("cash", 5, 10),
+            [
+                (5, 2, Decimal("3.00"), Decimal("13.00")),
+                (9, 3, Decimal("-4.00"), Decimal("9.00")),
+            ],
+        )
+
+    def test_orders_by_when_then_id(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "2"), ("bank", "-2")], when=10)
+        ledger.post([("cash", "3"), ("bank", "-3")], when=5)
+        ledger.post([("cash", "4"), ("bank", "-4")], when=10)
+        rows = ledger.statement("cash", 0, 100)
+        self.assertEqual([(row[0], row[1]) for row in rows], [(5, 2), (10, 1), (10, 3)])
+        self.assertEqual(
+            [row[3] for row in rows],
+            [Decimal("3.00"), Decimal("5.00"), Decimal("9.00")],
+        )
+
+    def test_zero_lines_are_omitted(self):
+        ledger = usd_ledger()
+        ledger.post(
+            [("cash", "5"), ("cash", "-5"), ("bank", "5"), ("bank", "-5")], when=1
+        )
+        self.assertEqual(ledger.statement("cash", 0, 10), [])
+
+    def test_start_after_end_raises(self):
+        ledger = usd_ledger()
+        with self.assertRaises(ValueError):
+            ledger.statement("cash", 5, 4)
+        self.assertEqual(ledger.statement("cash", 5, 5), [])
+
+    def test_start_is_inclusive(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1)
+        ledger.post([("cash", "3"), ("bank", "-3")], when=2)
+        self.assertEqual(
+            [(row[0], row[1]) for row in ledger.statement("cash", 1, 3)],
+            [(1, 1), (2, 2)],
+        )
+        self.assertEqual(
+            [(row[0], row[1]) for row in ledger.statement("cash", 2, 3)],
+            [(2, 2)],
+        )
+
+    def test_end_is_exclusive(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1)
+        self.assertEqual(ledger.statement("cash", 0, 1), [])
+        self.assertEqual(
+            ledger.statement("cash", 0, 2),
+            [(1, 1, Decimal("5.00"), Decimal("5.00"))],
+        )
+
+    def test_row_values_keep_exponent(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1)
+        (row,) = ledger.statement("cash", 0, 10)
+        self.assertEqual(places(row[2]), -2)
+        self.assertEqual(places(row[3]), -2)
+
+    def test_rows_include_reversals(self):
+        ledger = usd_ledger()
+        ledger.post([("cash", "5"), ("bank", "-5")], when=1)
+        ledger.reverse(1, when=3)
+        self.assertEqual(
+            ledger.statement("cash", 0, 10),
+            [
+                (1, 1, Decimal("5.00"), Decimal("5.00")),
+                (3, 2, Decimal("-5.00"), Decimal("0.00")),
+            ],
+        )
