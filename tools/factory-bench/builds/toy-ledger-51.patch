+class ReversalTests(unittest.TestCase):
+    """Test Property 8: Reversal."""
+
+    def setUp(self):
+        self.ledger = Ledger({"USD": 2})
+        self.ledger.open("cash", "USD")
+        self.ledger.open("expense", "USD")
+
+    def test_reverse_unknown_txn_raises(self):
+        """Unknown txn_id raises KeyError."""
+        with self.assertRaises(KeyError):
+            self.ledger.reverse(999, when=0)
+
+    def test_reverse_already_reversed_raises(self):
+        """Reversing already-reversed transaction raises ValueError."""
+        txn_id = self.ledger.post([("cash", "5"), ("expense", "-5")], when=10)
+        self.ledger.reverse(txn_id, when=11)
+        with self.assertRaises(ValueError):
+            self.ledger.reverse(txn_id, when=12)
+
+    def test_reverse_a_reversal_raises(self):
+        """Cannot reverse a reversal transaction."""
+        txn_id = self.ledger.post([("cash", "5"), ("expense", "-5")], when=10)
+        reversal_id = self.ledger.reverse(txn_id, when=11)
+        with self.assertRaises(ValueError):
+            self.ledger.reverse(reversal_id, when=12)
+
+    def test_reverse_timestamp_before_original_raises(self):
+        """Reversal timestamp before original raises ValueError."""
+        txn_id = self.ledger.post([("cash", "5"), ("expense", "-5")], when=10)
+        with self.assertRaises(ValueError):
+            self.ledger.reverse(txn_id, when=9)
+
+    def test_reverse_timestamp_equal_ok(self):
+        """Reversal timestamp equal to original is allowed."""
+        txn_id = self.ledger.post([("cash", "5"), ("expense", "-5")], when=10)
+        reversal_id = self.ledger.reverse(txn_id, when=10)
+        self.assertIsNotNone(reversal_id)
+
+    def test_reverse_closed_account_raises(self):
+        """Cannot reverse to a closed account."""
+        ledger = Ledger({"USD": 2})
+        ledger.open("cash", "USD")
+        ledger.open("expense", "USD")
+        
+        # Post txn with both cash and expense
+        txn_id1 = ledger.post([("cash", "5"), ("expense", "-5")], when=10)
+        # Post another txn that makes expense 0 (expense +5, cash -5)
+        ledger.post([("expense", "5"), ("cash", "-5")], when=15)
+        # Now expense is at 0 and cash is at 0, so we can close expense
+        ledger.close("expense")
+        # Try to reverse txn1 (which involves expense) - should fail
+        with self.assertRaises(ValueError):
+            ledger.reverse(txn_id1, when=16)
+
+    def test_reverse_negates_entries(self):
+        """Reversal negates the original entries."""
+        txn_id = self.ledger.post([("cash", "5"), ("expense", "-5")], when=10)
+        self.assertEqual(self.ledger.balance("cash"), Decimal("5.00"))
+        
+        self.ledger.reverse(txn_id, when=11)
+        self.assertEqual(self.ledger.balance("cash"), Decimal("0.00"))
+
+    def test_reverse_idempotent_key(self):
+        """Reversal with idempotent key works."""
+        txn_id = self.ledger.post([("cash", "5"), ("expense", "-5")], when=10)
+        rev_id1 = self.ledger.reverse(txn_id, when=11, key="rev_key")
+        rev_id2 = self.ledger.reverse(txn_id, when=11, key="rev_key")
+        # Second call returns cached result
+        self.assertEqual(rev_id1, rev_id2)
+
