-    pass
+    """Reservations of capacity for the nodes of a tenant tree."""
+
+    def __init__(self, tree, quotas):
+        if not tree:
+            raise ValueError("tree is empty")
+        nodes = set(tree)
+        roots = [node for node, parent in tree.items() if parent is None]
+        if len(roots) != 1:
+            raise ValueError("tree must have exactly one root")
+        for node, parent in tree.items():
+            if parent is not None and parent not in nodes:
+                raise ValueError(f"parent {parent!r} of {node!r} is not a node")
+        # Reject cycles: walking parents from any node must reach the root.
+        for node in nodes:
+            seen = set()
+            current = node
+            while current is not None:
+                if current in seen:
+                    raise ValueError("parent links form a cycle")
+                seen.add(current)
+                current = tree[current]
+        if set(quotas) != nodes:
+            raise ValueError("quotas must name exactly the nodes of the tree")
+        checked = {}
+        for node in nodes:
+            quota = quotas[node]
+            if not _is_int(quota) or quota < 0:
+                raise ValueError(f"quota of {node!r} is not an int of at least 0")
+            checked[node] = quota
+
+        self._tree = dict(tree)
+        self._quotas = checked
+        self._chain = {}
+        for node in nodes:
+            chain = []
+            current = node
+            while current is not None:
+                chain.append(current)
+                current = tree[current]
+            self._chain[node] = chain
+        self._steps = {node: _Steps() for node in nodes}
+        self._reservations = {}
+        self._keys = {}
+        self._next_id = 1
+        self._events = []
+
+    # -- internal helpers -------------------------------------------------
+
+    def _steps_for(self, reservation):
+        return (self._steps[node] for node in self._chain[reservation.node])
+
+    def _remove_usage(self, reservation):
+        for steps in self._steps_for(reservation):
+            steps.remove(reservation.start, reservation.end, reservation.units)
+
+    def _add_usage(self, reservation):
+        for steps in self._steps_for(reservation):
+            steps.add(reservation.start, reservation.end, reservation.units)
+
+    def _activate(self, reservation):
+        reservation.status = ACTIVE
+        self._add_usage(reservation)
+
+    def _displace(self, reservation, kind):
+        if reservation.status == ACTIVE:
+            self._remove_usage(reservation)
+        self._events.append((kind, reservation.id))
+        if reservation.wait:
+            reservation.status = WAITING
+            self._events.append((WAITING, reservation.id))
+        else:
+            reservation.status = kind
+
+    def _segment_starts(self, node, start, end):
+        """Candidate instants in [start, end) at which usage can change."""
+        starts = [start]
+        for point in self._steps[node].points():
+            if start < point < end:
+                starts.append(point)
+        return starts
+
+    def _first_violation(self, node, units, start, end):
+        """The nearest-node, lowest-instant violation, or None."""
+        for ancestor in self._chain[node]:
+            quota = self._quotas[ancestor]
+            steps = self._steps[ancestor]
+            for at in self._segment_starts(ancestor, start, end):
+                if steps.value(at) + units > quota:
+                    return (ancestor, at)
+        return None
+
+    def _covers_violation(self, node, units, start, end, candidate):
+        """True when a violation touches the candidate's node and interval."""
+        low = max(start, candidate.start)
+        high = min(end, candidate.end)
+        if low >= high:
+            return False
+        candidate_chain = self._chain[candidate.node]
+        for ancestor in self._chain[node]:
+            if ancestor not in candidate_chain:
+                continue
+            quota = self._quotas[ancestor]
+            steps = self._steps[ancestor]
+            starts = [low]
+            for point in steps.points():
+                if low < point < high:
+                    starts.append(point)
+            for at in starts:
+                if steps.value(at) + units > quota:
+                    return True
+        return False
+
+    def _usage_above(self, node, quota):
+        steps = self._steps[node]
+        for point in steps.points():
+            if steps.value(point) > quota:
+                return True
+        return False
+
+    def _covers_above(self, node, quota, start, end):
+        steps = self._steps[node]
+        points = steps.points()
+        for index, point in enumerate(points):
+            if steps.value(point) <= quota:
+                continue
+            segment_end = points[index + 1] if index + 1 < len(points) else None
+            low = max(start, point)
+            high = end if segment_end is None else min(end, segment_end)
+            if low < high:
+                return True
+        return False
+
+    @staticmethod
+    def _victim_key(reservation):
+        return (reservation.priority, -reservation.start, -reservation.id)
+
+    def _waiting_key(self, rid):
+        reservation = self._reservations[rid]
+        return (-reservation.priority, rid)
+
+    def _settle(self):
+        for rid in self.waiting():
+            reservation = self._reservations[rid]
+            if self._first_violation(
+                reservation.node, reservation.units, reservation.start, reservation.end
+            ) is None:
+                self._activate(reservation)
+                self._events.append(("promoted", rid))
+
+    def _preemption_pass(self, node, units, start, end, priority):
+        """Tentatively displace candidates.
+
+        Returns the list of displaced candidates when the request now fits, or
+        None after restoring every tentative displacement.
+        """
+        candidates = [
+            reservation
+            for reservation in self._reservations.values()
+            if reservation.status == ACTIVE
+            and reservation.priority < priority
+            and max(reservation.start, start) < min(reservation.end, end)
+        ]
+        candidates.sort(key=self._victim_key)
+        taken = []
+        for candidate in candidates:
+            if self._first_violation(node, units, start, end) is None:
+                break
+            if self._covers_violation(node, units, start, end, candidate):
+                self._remove_usage(candidate)
+                taken.append(candidate)
+        if self._first_violation(node, units, start, end) is None:
+            return taken
+        for candidate in taken:
+            self._add_usage(candidate)
+        return None
+
+    def _new_reservation(self, node, units, start, end, priority, wait, preempt):
+        rid = self._next_id
+        self._next_id += 1
+        reservation = _Reservation(rid, node, units, start, end, priority, wait, preempt)
+        self._reservations[rid] = reservation
+        return reservation
+
+    def _claim(self, key, rid, request):
+        if key is not None:
+            self._keys[key] = (rid, request)
+
+    # -- public surface ---------------------------------------------------
+
+    def reserve(
+        self,
+        node,
+        units,
+        start,
+        end,
+        *,
+        priority=0,
+        key=None,
+        wait=False,
+        preempt=False,
+    ):
+        if node not in self._tree:
+            raise KeyError(node)
+        if not _is_int(units) or units < 1:
+            raise ValueError("units must be an int of at least 1")
+        if not _is_int(start) or not _is_int(end):
+            raise ValueError("start and end must be ints")
+        if start >= end:
+            raise ValueError("start must be below end")
+        if not _is_int(priority) or not 0 <= priority <= 9:
+            raise ValueError("priority must be an int from 0 to 9")
+
+        request = (node, units, start, end, priority, wait, preempt)
+        if key is not None and key in self._keys:
+            rid, previous = self._keys[key]
+            if previous != request:
+                raise ValueError("key was claimed by a different request")
+            return rid
+
+        first = self._first_violation(node, units, start, end)
+        if first is None:
+            reservation = self._new_reservation(
+                node, units, start, end, priority, wait, preempt
+            )
+            self._activate(reservation)
+            self._events.append((ACTIVE, reservation.id))
+            self._claim(key, reservation.id, request)
+            return reservation.id
+
+        if preempt:
+            taken = self._preemption_pass(node, units, start, end, priority)
+            if taken is not None:
+                for candidate in taken:
+                    self._events.append((PREEMPTED, candidate.id))
+                    if candidate.wait:
+                        candidate.status = WAITING
+                        self._events.append((WAITING, candidate.id))
+                    else:
+                        candidate.status = PREEMPTED
+                reservation = self._new_reservation(
+                    node, units, start, end, priority, wait, preempt
+                )
+                self._activate(reservation)
+                self._events.append((ACTIVE, reservation.id))
+                self._settle()
+                self._claim(key, reservation.id, request)
+                return reservation.id
+
+        if wait:
+            reservation = self._new_reservation(
+                node, units, start, end, priority, wait, preempt
+            )
+            self._events.append((WAITING, reservation.id))
+            self._claim(key, reservation.id, request)
+            return reservation.id
+
+        raise NoCapacity(first[0], first[1])
+
+    def cancel(self, rid):
+        reservation = self._reservations.get(rid)
+        if reservation is None:
+            raise KeyError(rid)
+        if reservation.status not in (ACTIVE, WAITING):
+            raise ValueError(f"reservation {rid} is {reservation.status}")
+        if reservation.status == ACTIVE:
+            self._remove_usage(reservation)
+        reservation.status = CANCELLED
+        self._events.append((CANCELLED, rid))
+        self._settle()
+
+    def set_quota(self, node, quota, *, evict=False):
+        if node not in self._tree:
+            raise KeyError(node)
+        if not _is_int(quota) or quota < 0:
+            raise ValueError("quota must be an int of at least 0")
+        old = self._quotas[node]
+        if quota == old:
+            return
+        above = self._usage_above(node, quota)
+        if above and not evict:
+            raise ValueError(f"usage above the new quota of {node!r}")
+        self._quotas[node] = quota
+        self._events.append(("quota", node, old, quota))
+        if above:
+            candidates = [
+                reservation
+                for reservation in self._reservations.values()
+                if reservation.status == ACTIVE and node in self._chain[reservation.node]
+            ]
+            candidates.sort(key=self._victim_key)
+            for candidate in candidates:
+                if not self._usage_above(node, quota):
+                    break
+                if self._covers_above(node, quota, candidate.start, candidate.end):
+                    self._displace(candidate, EVICTED)
+        self._settle()
+
+    def usage(self, node, at):
+        if node not in self._tree:
+            raise KeyError(node)
+        return self._steps[node].value(at)
+
+    def peak(self, node, start, end):
+        if node not in self._tree:
+            raise KeyError(node)
+        if start >= end:
+            raise ValueError("start must be below end")
+        steps = self._steps[node]
+        best = steps.value(start)
+        for point in steps.points():
+            if start < point < end:
+                best = max(best, steps.value(point))
+        return best
+
+    def timeline(self, node):
+        if node not in self._tree:
+            raise KeyError(node)
+        steps = self._steps[node]
+        return [(point, steps.value(point)) for point in steps.points()]
+
+    def status(self, rid):
+        reservation = self._reservations.get(rid)
+        if reservation is None:
+            raise KeyError(rid)
+        return reservation.status
+
+    def waiting(self):
+        return sorted(
+            (
+                reservation.id
+                for reservation in self._reservations.values()
+                if reservation.status == WAITING
+            ),
+            key=self._waiting_key,
+        )
+
+    def events(self):
+        return list(self._events)
